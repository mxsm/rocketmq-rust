          "type": "string"
        },
        "proxy_name": {
          "description": "Name of a Proxy as configured for this cluster on the server. It is a configured alias, not a network address.",
          "type": "string"
        }
      },
      "required": [
        "cluster",
        "proxy_name"
      ],
      "type": "object"
    },
