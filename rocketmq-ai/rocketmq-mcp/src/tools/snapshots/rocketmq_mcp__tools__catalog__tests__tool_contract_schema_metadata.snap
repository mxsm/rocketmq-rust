          "description": "Rust module path of the Broker logger to inspect. It must start with `rocketmq_broker::`, for example `rocketmq_broker::processor`, and be at most 128 bytes.",
          "type": "string"
        }
      },
      "required": [
        "cluster",
        "broker_name",
        "logger"
      ],
      "type": "object"
    },
