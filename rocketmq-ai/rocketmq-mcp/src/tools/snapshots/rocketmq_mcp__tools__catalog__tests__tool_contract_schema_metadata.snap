    },
    "description": "Returns where one Topic is hosted: the Brokers that serve it and each Broker's read and write queue counts and permission. Use it to check that a Topic exists and how it is spread over Brokers. For message counts and offsets use rocketmq_get_topic_stats; for configuration differences use rocketmq_get_topic_config.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cluster": {
