              "items": {
                "$ref": "#/$defs/BrokerHaObservation"
              },
              "type": "array"
            },
            "cluster": {
              "type": "string"
            },
            "controller_sync_states": {
              "items": {
                "$ref": "#/$defs/ControllerSyncStateObservation"
              },
              "type": "array"
            }
          },
          "required": [
            "cluster",
            "brokers",
            "controller_sync_states"
          ],
          "type": "object"
        },
        "HaConnectionObservation": {
          "additionalProperties": false,
          "properties": {
            "diff": {
              "format": "int64",
              "type": "integer"
            },
            "in_sync": {
              "type": "boolean"
            },
