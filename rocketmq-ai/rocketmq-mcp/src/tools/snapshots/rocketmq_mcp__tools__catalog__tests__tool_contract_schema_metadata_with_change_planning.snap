              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "generated_at": {
              "type": "string"
            },
            "topic_count": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "cluster",
            "brokers",
            "topic_count",
            "consumer_group_count",
            "generated_at"
          ],
          "type": "object"
        },
        "QuerySource": {
          "enum": [
            "broker_runtime",
            "broker_config",
            "broker_log_filter",
            "consumer_statistics",
            "consumer_connection",
            "producer_connection",
