            ],
            "type": "object"
          },
          "SourceFailureCode": {
            "enum": [
              "source_unavailable",
              "timeout",
              "permission_denied",
              "not_found",
              "rate_limited",
              "invalid_response"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "cache_status": {
            "$ref": "#/$defs/CacheStatus"
          },
          "cluster": {
            "type": "string"
          },
          "data": {
            "$ref": "#/$defs/ClusterOverviewOutput"
          },
          "freshness_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "observed_at": {
            "type": "string"
          },
          "partial": {
