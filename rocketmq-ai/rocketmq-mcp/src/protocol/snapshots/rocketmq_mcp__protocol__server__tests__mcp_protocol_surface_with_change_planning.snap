    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "RocketMQ Lite Topic state of a Broker"
      },
      "description": "Returns what one Broker holds for Lite Topics: the queues it has and the most it accepts, its subscription, offset and event counters, and the Lite Topics it knows with their expiration and bound Consumer Groups. Use it to check whether a Broker is close to its Lite Topic limit, or which groups are bound to a Lite Topic. It asks the master of the Broker.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "broker_name": {
            "description": "Logical Broker name as reported by `rocketmq_list_brokers`, for example `broker-a`. It is a name, not a network address.",
            "type": "string"
          },
          "cluster": {
            "description": "Logical cluster name configured on this server. It is a name, not a NameServer address.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "cluster",
          "broker_name"
        ],
        "type": "object"
      },
      "name": "rocketmq_get_lite_broker_info",
      "outputSchema": {
        "$defs": {
          "CacheStatus": {
            "enum": [
              "bypass",
              "hit",
              "miss"
            ],
            "type": "string"
          },
          "GetLiteBrokerInfoOutput": {
            "properties": {
              "broker_name": {
                "type": "string"
              },
              "cluster": {
                "type": "string"
              },
              "consume_queue_count": {
                "format": "int32",
                "type": "integer"
              },
              "current_lmq_count": {
                "description": "The Lite Topic queues the Broker holds now.",
                "format": "int32",
                "type": "integer"
              },
              "event_count": {
                "format": "int32",
                "type": "integer"
              },
              "generated_at": {
                "type": "string"
              },
              "lite_subscription_count": {
                "format": "int32",
                "type": "integer"
              },
              "lite_topic_count": {
                "description": "How many Lite Topics the Broker knows.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "lite_topics": {
                "description": "The Lite Topics in ascending order of name, at most 100.",
                "items": {
                  "$ref": "#/$defs/LiteTopicSummary"
                },
                "type": "array"
              },
              "max_lmq_count": {
                "description": "The most Lite Topic queues the Broker accepts.",
                "format": "int32",
                "type": "integer"
              },
              "offset_count": {
                "format": "int32",
                "type": "integer"
              },
              "order_info_count": {
                "format": "int32",
                "type": "integer"
              },
              "store_type": {
                "description": "The kind of store the Broker keeps Lite Topic queues in.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "truncated": {
                "description": "Whether Lite Topics or bound groups beyond those bounds were left out. The counts still cover them.",
                "type": "boolean"
              }
            },
            "required": [
              "cluster",
              "broker_name",
              "max_lmq_count",
              "current_lmq_count",
              "lite_subscription_count",
              "order_info_count",
              "consume_queue_count",
              "offset_count",
              "event_count",
              "lite_topic_count",
              "lite_topics",
              "truncated",
              "generated_at"
            ],
            "type": "object"
          },
          "LiteTopicSummary": {
            "properties": {
              "bound_group_count": {
                "description": "How many Consumer Groups are bound to the Topic.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "bound_groups": {
                "description": "The bound Consumer Groups in ascending order, at most 8.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "expiration_minutes": {
                "description": "How long an idle Lite Topic is kept, in minutes. `-1` when no expiration is configured.",
                "format": "int32",
                "type": "integer"
              },
              "topic": {
                "type": "string"
              }
            },
            "required": [
              "topic",
              "expiration_minutes",
              "bound_group_count",
              "bound_groups"
            ],
            "type": "object"
          },
          "QuerySource": {
            "enum": [
              "broker_runtime",
              "broker_config",
              "broker_log_filter",
              "consumer_statistics",
              "consumer_connection",
              "producer_connection",
              "topic_config",
              "topic_stats",
              "consumer_group_config",
              "subscription_groups",
              "topic_route",
              "broker_ha_runtime",
              "controller_sync_state",
              "controller_metadata",
              "nameserver_config"
            ],
            "type": "string"
          },
          "SourceFailure": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/$defs/SourceFailureCode"
              },
              "logical_target": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "source": {
                "$ref": "#/$defs/QuerySource"
              }
            },
            "required": [
              "source",
              "code",
              "retryable",
              "logical_target"
            ],
            "type": "object"
          },
          "SourceFailureCode": {
            "enum": [
              "source_unavailable",
              "timeout",
              "permission_denied",
              "not_found",
              "rate_limited",
              "invalid_response"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "cache_status": {
            "$ref": "#/$defs/CacheStatus"
          },
          "cluster": {
            "type": "string"
          },
          "data": {
            "$ref": "#/$defs/GetLiteBrokerInfoOutput"
          },
          "freshness_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "observed_at": {
            "type": "string"
          },
          "partial": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "source_failures": {
            "items": {
              "$ref": "#/$defs/SourceFailure"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "cluster",
          "observed_at",
          "freshness_ms",
          "cache_status",
          "partial",
          "warnings",
          "data"
        ],
        "type": "object"
      },
      "title": "RocketMQ Lite Topic state of a Broker"
    },
