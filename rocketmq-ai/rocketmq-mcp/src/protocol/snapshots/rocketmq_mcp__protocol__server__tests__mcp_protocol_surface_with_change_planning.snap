    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "RocketMQ message delivery diagnosis"
      },
      "description": "Checks the path from one Topic to one Consumer Group: whether Brokers accept writes and serve reads, whether consumers are online and enabled, and whether the group has progress and keeps up. With message_id it also says whether the group consumed that message, waits for it, retries it or dead-lettered it. Use it first when a message does not arrive. Never returns a body.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "description": "Logical cluster name configured on this server. It is a name, not a NameServer address.",
            "minLength": 1,
            "type": "string"
          },
          "consumer_group": {
            "description": "Exact name of the Consumer Group that should receive them. `rocketmq_list_consumer_groups` lists the names.",
            "type": "string"
          },
          "message_id": {
            "default": null,
            "description": "Identifier of one message to locate, exactly as RocketMQ reported it. Omit it to check the path only. The report names the message by a pseudonym and never holds its body.",
            "type": [
              "string",
              "null"
            ]
          },
          "topic": {
            "description": "Exact name of the Topic the messages are produced to. `rocketmq_list_topics` lists the names.",
            "type": "string"
          }
        },
        "required": [
          "cluster",
          "topic",
          "consumer_group"
        ],
        "type": "object"
      },
      "name": "rocketmq_diagnose_message_delivery",
      "outputSchema": {
        "$defs": {
          "CacheStatus": {
            "enum": [
              "bypass",
              "hit",
              "miss"
            ],
            "type": "string"
          },
          "ConfidenceBand": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "DiagnosisReport": {
            "description": "A diagnosis and the evidence it was evaluated on. `evidence_snapshot` is the only place the evidence appears; `evidence_refs`, `missing_evidence` and `root_causes[].evidence_refs` name its items by `id`.",
            "properties": {
              "cluster": {
                "type": "string"
              },
              "confidence": {
                "format": "float",
                "type": "number"
              },
              "confidence_band": {
                "$ref": "#/$defs/ConfidenceBand"
              },
              "evidence_refs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "evidence_snapshot": {
                "$ref": "#/$defs/EvidenceSnapshot"
              },
              "evidence_version": {
                "type": "string"
              },
              "follow_up_metrics": {
                "items": {
                  "$ref": "#/$defs/MetricWatchItem"
                },
                "type": "array"
              },
              "generated_at": {
                "type": "string"
              },
              "impacts": {
                "items": {
                  "$ref": "#/$defs/ImpactItem"
                },
