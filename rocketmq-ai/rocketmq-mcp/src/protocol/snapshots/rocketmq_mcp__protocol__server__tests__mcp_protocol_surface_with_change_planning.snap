      "description": "Authenticated, bounded, and sanitized MCP runtime diagnostics.",
      "mimeType": "application/json",
      "name": "system_runtime_v1",
      "title": "RocketMQ MCP runtime diagnostics",
      "uri": "rocketmq://system/runtime/v1"
    },
    {
      "description": "Authenticated and sanitized MCP observability status.",
      "mimeType": "application/json",
      "name": "system_observability_v1",
      "title": "RocketMQ MCP observability status",
      "uri": "rocketmq://system/observability/v1"
    }
