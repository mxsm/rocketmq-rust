                },
                "type": "array"
              },
              "rules_version": {
                "type": "string"
              },
              "severity": {
                "$ref": "#/$defs/Severity"
              },
              "summary": {
                "type": "string"
              },
              "target": true
            },
            "required": [
              "report_type",
              "evidence_version",
              "rules_version",
              "cluster",
              "target",
              "severity",
              "confidence",
              "confidence_band",
              "policy_profile",
