        "readOnlyHint": true,
        "title": "RocketMQ consumer groups"
      },
      "description": "Lists the Consumer Groups of one cluster, a page at a time, with client count, consume type, TPS and total lag for each. Use it to find the exact name of a group or to spot the groups that are behind. Next, call rocketmq_get_consumer_lag or rocketmq_diagnose_consumer_lag for one group.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "default": null,
            "description": "Logical cluster name configured on this server. When it is omitted or null, the cluster marked as default is used, or the only configured cluster.",
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "cursor": {
            "default": null,
            "description": "Continuation token. To read the next page, pass the `next_cursor` of the previous response unchanged, together with the same arguments and `limit`. Omit it for the first page.",
            "type": [
              "string",
              "null"
            ]
          },
          "filter": {
            "default": null,
            "description": "Keeps only the Consumer Groups whose name contains this text, ignoring ASCII case. At most 1,024 bytes. Omit it to list every Consumer Group.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Maximum number of items in the returned page, from 1 to 200. Defaults to 50.",
            "format": "uint32",
            "maximum": 200,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "response_format": {
            "default": "detailed",
            "description": "How much of each item to return. `detailed`, the default, returns every field. `concise` returns only the fields that name an item, which is smaller and can be faster: use it to find a name, then ask for one item.",
            "enum": [
              "concise",
              "detailed"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
