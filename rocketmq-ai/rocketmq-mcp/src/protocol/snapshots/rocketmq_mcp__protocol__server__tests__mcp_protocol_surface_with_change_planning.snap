                "format": "int32",
                "type": "integer"
              },
              "queue_offset": {
                "format": "int64",
                "type": "integer"
              },
              "reconsume_times": {
                "format": "int32",
                "type": "integer"
              },
              "store_size": {
                "format": "int32",
                "type": "integer"
              },
              "stored_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sys_flag": {
                "format": "int32",
                "type": "integer"
              },
              "unique_message_alias": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
