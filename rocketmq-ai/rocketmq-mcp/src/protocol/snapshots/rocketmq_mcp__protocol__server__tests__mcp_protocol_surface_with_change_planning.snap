    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "RocketMQ consumer lag diagnosis"
      },
      "description": "Explains the lag of one Consumer Group on one Topic. It reads the lag of every queue, the connections and configuration of the group, the route and permissions of the Topic, and the retry and dead-letter Topics, then reports a severity, likely causes and recommendations. Use it when a group is behind and you need a cause. For the raw per-queue numbers use rocketmq_get_consumer_lag.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "description": "Logical cluster name configured on this server. It is a name, not a NameServer address.",
            "minLength": 1,
            "type": "string"
          },
          "consumer_group": {
            "description": "Exact Consumer Group name. `rocketmq_list_consumer_groups` lists the names.",
            "type": "string"
          },
          "topic": {
            "description": "Exact Topic name. `rocketmq_list_topics` lists the names.",
            "type": "string"
          }
        },
        "required": [
          "cluster",
          "topic",
          "consumer_group"
        ],
        "type": "object"
      },
      "name": "rocketmq_diagnose_consumer_lag",
      "outputSchema": {
        "$defs": {
          "CacheStatus": {
            "enum": [
              "bypass",
              "hit",
              "miss"
            ],
            "type": "string"
          },
          "ConfidenceBand": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "DiagnosisReport": {
            "description": "A diagnosis and the evidence it was evaluated on. `evidence_snapshot` is the only place the evidence appears; `evidence_refs`, `missing_evidence` and `root_causes[].evidence_refs` name its items by `id`.",
            "properties": {
              "cluster": {
                "type": "string"
              },
              "confidence": {
                "format": "float",
                "type": "number"
              },
              "confidence_band": {
                "$ref": "#/$defs/ConfidenceBand"
              },
              "evidence_refs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "evidence_snapshot": {
                "$ref": "#/$defs/EvidenceSnapshot"
              },
              "evidence_version": {
                "type": "string"
              },
              "follow_up_metrics": {
                "items": {
                  "$ref": "#/$defs/MetricWatchItem"
                },
                "type": "array"
              },
              "generated_at": {
                "type": "string"
              },
              "impacts": {
                "items": {
                  "$ref": "#/$defs/ImpactItem"
                },
                "type": "array"
              },
              "missing_evidence": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "partial": {
                "type": "boolean"
              },
              "policy_profile": {
                "type": "string"
              },
              "recommendations": {
                "items": {
                  "$ref": "#/$defs/Recommendation"
                },
                "type": "array"
              },
              "report_type": {
                "type": "string"
              },
              "risks": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "root_causes": {
                "items": {
                  "$ref": "#/$defs/RootCauseCandidate"
                },
                "type": "array"
              },
              "rules_version": {
                "type": "string"
              },
              "severity": {
                "$ref": "#/$defs/Severity"
              },
              "summary": {
                "type": "string"
              },
              "target": true
            },
            "required": [
              "report_type",
              "evidence_version",
              "rules_version",
              "cluster",
              "target",
              "severity",
              "confidence",
              "confidence_band",
              "policy_profile",
              "partial",
              "missing_evidence",
              "evidence_refs",
              "evidence_snapshot",
              "summary",
              "impacts",
              "root_causes",
              "recommendations",
              "risks",
              "follow_up_metrics",
              "generated_at"
            ],
            "type": "object"
          },
          "EvidenceItem": {
            "properties": {
              "error_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "freshness_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/EvidenceKind"
              },
