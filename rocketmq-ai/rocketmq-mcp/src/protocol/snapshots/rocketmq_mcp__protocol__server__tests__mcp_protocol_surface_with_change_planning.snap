              },
              "items": {
                "items": {
                  "$ref": "#/$defs/TopicRouteQueue"
                },
                "type": "array"
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "read_queue_count": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "topic": {
                "type": "string"
              },
              "total_count": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "write_queue_count": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cluster",
              "topic",
              "broker_names",
              "read_queue_count",
              "write_queue_count",
              "brokers",
              "items",
              "count",
              "total_count",
              "has_more",
              "generated_at"
            ],
            "type": "object"
          },
          "QuerySource": {
            "enum": [
              "broker_runtime",
              "broker_config",
