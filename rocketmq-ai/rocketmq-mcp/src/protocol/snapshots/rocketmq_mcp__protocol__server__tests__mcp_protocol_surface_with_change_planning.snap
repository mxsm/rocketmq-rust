                  "data"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "data": true,
                  "kind": {
                    "const": "message_metadata",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "data"
                ],
                "type": "object"
              }
            ]
          },
          "EvidenceSnapshot": {
            "properties": {
              "cluster": {
                "type": "string"
              },
              "evidence_version": {
                "type": "string"
              },
              "items": {
