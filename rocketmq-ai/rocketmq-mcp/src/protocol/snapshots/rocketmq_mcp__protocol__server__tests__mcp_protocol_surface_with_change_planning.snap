                  }
                },
                "required": [
                  "kind",
                  "data"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "data": true,
                  "kind": {
                    "const": "broker_config",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "data"
