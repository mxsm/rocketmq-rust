    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "RocketMQ consumer group details"
      },
      "description": "Returns how one Consumer Group is set up on each Broker: whether it is configured there, whether clients are connected, its consume type, and the total connection count. Use it to check that a group exists and is online. For lag use rocketmq_get_consumer_lag; for the connected clients use rocketmq_list_consumer_connections.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
