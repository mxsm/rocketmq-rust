      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "RocketMQ message metadata"
      },
      "description": "Returns the metadata of one message by its identifier: Topic, queue and offset, size, born and stored times, and reconsume count. Use it to confirm that a message was stored, and where. The body is never returned and message identifiers are replaced by pseudonyms.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "description": "Logical cluster name configured on this server. It is a name, not a NameServer address.",
            "minLength": 1,
            "type": "string"
          },
          "message_id": {
            "description": "Identifier of the message to read, exactly as RocketMQ reported it.",
            "type": "string"
          }
        },
        "required": [
          "cluster",
          "message_id"
        ],
        "type": "object"
      },
      "name": "rocketmq_get_message_metadata",
      "outputSchema": {
        "$defs": {
          "CacheStatus": {
            "enum": [
              "bypass",
              "hit",
              "miss"
            ],
            "type": "string"
          },
          "MessageMetadataOutput": {
            "properties": {
              "born_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cluster": {
                "type": "string"
              },
              "flag": {
                "format": "int32",
                "type": "integer"
              },
              "message_alias": {
                "type": "string"
              },
