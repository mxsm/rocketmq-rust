    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "RocketMQ topic list"
      },
      "description": "Lists the Topic names of one cluster, a page at a time, optionally keeping only names that contain a text. Use it to find the exact name of a Topic. A cluster with more than 10,000 Topics needs a filter. Next, pass a name to rocketmq_get_topic_route or rocketmq_get_topic_stats.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "default": null,
            "description": "Logical cluster name configured on this server. When it is omitted or null, the cluster marked as default is used, or the only configured cluster.",
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "cursor": {
            "default": null,
            "description": "Continuation token. To read the next page, pass the `next_cursor` of the previous response unchanged, together with the same arguments and `limit`. Omit it for the first page.",
            "type": [
              "string",
              "null"
            ]
          },
          "filter": {
            "default": null,
            "description": "Keeps only the Topics whose name contains this text, ignoring ASCII case. At most 1,024 bytes. Omit it to list every Topic.",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "description": "Maximum number of items in the returned page, from 1 to 200. Defaults to 50.",
            "format": "uint32",
            "maximum": 200,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "response_format": {
            "default": "detailed",
            "description": "How much of each item to return. `detailed`, the default, returns every field. `concise` returns only the fields that name an item, which is smaller and can be faster: use it to find a name, then ask for one item.",
            "enum": [
              "concise",
              "detailed"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
