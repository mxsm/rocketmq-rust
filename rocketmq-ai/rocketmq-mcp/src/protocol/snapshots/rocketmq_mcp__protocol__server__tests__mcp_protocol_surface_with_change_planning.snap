                "minimum": 0,
                "type": "integer"
              },
              "state": {
                "$ref": "#/$defs/ConsumerProgressState"
              },
              "topic_count": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "total_count": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "total_inflight": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "total_lag": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "truncated": {
