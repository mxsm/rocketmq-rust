            "description": "Logical cluster name configured on this server. It is a name, not a NameServer address.",
            "minLength": 1,
            "type": "string"
          },
          "response_format": {
            "default": "detailed",
            "description": "How much of each item to return. `detailed`, the default, returns every field. `concise` returns only the fields that name an item, which is smaller and can be faster: use it to find a name, then ask for one item.",
            "enum": [
              "concise",
              "detailed"
            ],
            "type": "string"
          }
        },
