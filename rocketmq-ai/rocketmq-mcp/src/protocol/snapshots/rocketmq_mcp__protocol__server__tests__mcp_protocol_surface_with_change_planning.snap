                "type": [
                  "boolean",
                  "null"
                ]
              },
              "consume_timeout_minutes": {
                "format": "int32",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "consume_type": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ConsumerConsumeType"
                  },
                  {
                    "type": "null"
                  }
