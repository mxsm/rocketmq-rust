    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "RocketMQ cluster list"
      },
      "description": "Lists the logical clusters you may query, with the Proxy and Controller aliases of each and which one is the default. Use it first, to learn the names that the cluster, proxy_name and controller_names arguments of the other Tools accept. It takes no argument and reads no cluster; for the Brokers of a cluster call rocketmq_list_brokers.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object"
      },
      "name": "rocketmq_list_clusters",
      "outputSchema": {
        "$defs": {
          "CacheStatus": {
            "enum": [
              "bypass",
              "hit",
              "miss"
            ],
            "type": "string"
          },
          "ClusterEntry": {
            "description": "One logical cluster the caller may query, with the names its other Tools accept.\n\nIt carries names only. NameServer addresses, Proxy and Controller endpoints, and the physical cluster name are server configuration and never leave it.",
            "properties": {
              "controller_names": {
                "description": "Controller aliases of this cluster. Pass some as `controller_names` to rocketmq_get_ha_status or rocketmq_get_controller_metadata to narrow them to those Controllers.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "default": {
                "description": "Whether a Tool that allows `cluster` to be omitted selects this cluster.",
                "type": "boolean"
              },
              "name": {
                "description": "Logical cluster name. Pass it as the `cluster` argument of every other Tool.",
                "type": "string"
              },
              "proxy_names": {
                "description": "Proxy aliases of this cluster. Pass one as `proxy_name` to rocketmq_get_proxy_drain_state.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "default",
              "proxy_names",
              "controller_names"
            ],
            "type": "object"
          },
          "ListClustersOutput": {
            "properties": {
              "clusters": {
                "description": "The clusters the caller may query, in configuration order. A cluster the caller has no access to is left out, so the list can be shorter than the server's configuration.",
                "items": {
                  "$ref": "#/$defs/ClusterEntry"
                },
                "type": "array"
              }
            },
            "required": [
              "clusters"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "cache_status": {
            "$ref": "#/$defs/CacheStatus"
          },
          "data": {
            "$ref": "#/$defs/ListClustersOutput"
          },
          "freshness_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "observed_at": {
            "type": "string"
          },
          "partial": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "observed_at",
          "freshness_ms",
          "cache_status",
          "partial",
          "warnings",
          "data"
        ],
        "type": "object"
      },
      "title": "RocketMQ cluster list"
    },
    {
      "annotations": {
