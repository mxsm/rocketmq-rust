{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "GovernanceAccessPath": {
      "description": "Requested access path for governance admission.",
      "enum": [
        "read_only",
        "high_privilege"
      ],
      "type": "string"
    },
    "GovernanceAdmissionId": {
      "description": "Stable identifier for one immutable governance admission decision.",
      "format": "uuid",
      "type": "string"
    },
    "GovernanceVersionId": {
      "description": "Stable identifier for an immutable governed artifact version.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Persisted fail-closed admission decision.",
  "properties": {
    "access_path": {
      "$ref": "#/$defs/GovernanceAccessPath"
    },
    "allowed": {
      "type": "boolean"
    },
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "degraded": {
      "type": "boolean"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/GovernanceAdmissionId"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_version_ids": {
      "items": {
        "$ref": "#/$defs/GovernanceVersionId"
      },
      "type": "array"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "access_path",
    "required_version_ids",
    "allowed",
    "degraded",
    "reason_codes",
    "evaluated_at"
  ],
  "title": "GovernanceAdmission",
  "type": "object"
}
