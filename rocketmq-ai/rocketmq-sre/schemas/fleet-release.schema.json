{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "CorrelationId": {
      "description": "Identifier propagated across one logical SRE operation.",
      "format": "uuid",
      "type": "string"
    },
    "FleetId": {
      "description": "Stable identifier for an enterprise RocketMQ fleet.",
      "format": "uuid",
      "type": "string"
    },
    "FleetReleaseBatch": {
      "additionalProperties": false,
      "description": "Deterministic regional batch in a Fleet release.",
      "properties": {
        "canary": {
          "type": "boolean"
        },
        "cluster_ids": {
          "items": {
            "$ref": "#/$defs/ClusterId"
          },
          "type": "array"
        },
        "max_concurrency": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "region_id": {
          "$ref": "#/$defs/RegionId"
        },
        "sequence": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "region_id",
        "cluster_ids",
        "max_concurrency",
        "canary"
      ],
      "type": "object"
    },
    "FleetReleaseId": {
      "description": "Stable identifier for one multi-cluster Fleet release.",
      "format": "uuid",
      "type": "string"
    },
    "FleetReleaseStatus": {
      "description": "Aggregate lifecycle for a bounded multi-cluster release.",
      "enum": [
        "planned",
        "readiness_checking",
        "ready",
        "canary_running",
        "batch_running",
        "paused",
        "verifying",
        "rolling_back",
        "rolled_back",
        "completed",
        "manual_takeover",
        "failed"
      ],
      "type": "string"
    },
    "RegionId": {
      "description": "Stable identifier for a data-residency region.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable aggregate that coordinates independent per-cluster release workflows.",
  "properties": {
    "active_batch": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "artifact_digest": {
      "type": "string"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/FleetReleaseBatch"
      },
      "type": "array"
    },
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "fleet_id": {
      "$ref": "#/$defs/FleetId"
    },
    "id": {
      "$ref": "#/$defs/FleetReleaseId"
    },
    "maintenance_window_end": {
      "format": "date-time",
      "type": "string"
    },
    "maintenance_window_start": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "release_ref": {
      "type": "string"
    },
    "rollback_artifact_digest": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "slo_policy_id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FleetReleaseStatus"
    },
    "target_version": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "fleet_id",
    "tenant_id",
    "correlation_id",
    "release_ref",
    "artifact_digest",
    "target_version",
    "owner",
    "maintenance_window_start",
    "maintenance_window_end",
    "rollback_artifact_digest",
    "slo_policy_id",
    "status",
    "batches",
    "created_at",
    "updated_at"
  ],
  "title": "FleetRelease",
  "type": "object"
}
