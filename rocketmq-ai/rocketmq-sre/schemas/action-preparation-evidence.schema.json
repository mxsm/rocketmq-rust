{
  "$defs": {
    "ActionPreparationBinding": {
      "additionalProperties": false,
      "description": "CP record of the exact readonly request which produced a prepared observation.\n\nThis is not an Agent signature or action consent. The immutable Evidence hash\nbinds it together with the unchanged Agent response.",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "actor_subject": {
          "type": "string"
        },
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "descriptor_version": {
          "type": "string"
        },
        "diagnosis_revision_id": {
          "$ref": "#/$defs/DiagnosisRevisionId"
        },
        "diagnostic_evidence": {
          "items": {
            "$ref": "#/$defs/ActionReadinessEvidenceBinding"
          },
          "type": "array"
        },
        "incident_id": {
          "$ref": "#/$defs/IncidentId"
        },
        "parameters_digest": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "prepared_at": {
          "format": "date-time",
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "target_scope_digest": {
          "type": "string"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "valid_until": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "cluster_id",
        "incident_id",
        "diagnosis_revision_id",
        "action_id",
        "descriptor_version",
        "resource",
        "parameters_digest",
        "target_scope_digest",
        "diagnostic_evidence",
        "policy_version",
        "actor_subject",
        "prepared_at",
        "valid_until"
      ],
      "type": "object"
    },
    "ActionReadinessEvidenceBinding": {
      "additionalProperties": false,
      "description": "Immutable evidence identity; a newer same-resource record cannot replace it.",
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        }
      },
      "required": [
        "evidence_id",
        "content_hash"
      ],
      "type": "object"
    },
    "AgentReadResult": {
      "additionalProperties": false,
      "description": "Sanitized live-state result. It never contains target configuration dumps.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ExecutionAction"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "precondition_hash": {
          "type": "string"
        },
        "ready": {
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resource_conditions": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "type": "object"
        },
        "schema_version": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "action",
        "target",
        "precondition_hash",
        "ready",
        "reason_codes",
        "observed_at"
      ],
      "type": "object"
    },
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "DiagnosisRevisionId": {
      "description": "Stable identifier for an immutable diagnosis revision.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "ExecutionAction": {
      "description": "Closed set of Phase 3 actions that may enter supervised planning.\n\nExecution remains gated by the exact descriptor's `plan_only` and\n`execution_supported` flags. Permanently destructive R3 and unknown actions\nare intentionally not representable.",
      "enum": [
        "observability.logger_level_ttl.v1",
        "proxy.scale_out_one.v1",
        "proxy.restart_one.v1",
        "broker.config.patch_allowlisted.v1",
        "topic.config.patch_allowlisted.v1",
        "subscription_group.patch_allowlisted.v1",
        "consumer.request_mode.patch_allowlisted.v1",
        "consumer.offset.reset_bounded.v1",
        "topic.queue.expand_only.v1",
        "namesrv.config.patch_allowlisted.v1",
        "controller.config.patch_allowlisted.v1",
        "proxy.rollout_image_canary.v1",
        "broker.restart_one.v1",
        "static_topic.patch_non_remap.v1",
        "tiered.cold_data_flow.patch_allowlisted.v1",
        "store.readahead.patch_allowlisted.v1",
        "security.credential_rotate_overlap.v1",
        "telemetry.collector.restart_one.v1",
        "consumer.offset.clone_or_reset_broad.v1",
        "message.direct_consume.v1",
        "message.dlq.resend.v1",
        "timer.switch.v1",
        "controller.elect.v1",
        "static_topic.remap.v1",
        "broker.container.add_remove.v1"
      ],
      "type": "string"
    },
    "IncidentId": {
      "description": "Stable identifier for an SRE incident.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned CP-owned evidence content; the Agent's wire DTO remains unchanged.",
  "properties": {
    "agent_result": {
      "$ref": "#/$defs/AgentReadResult"
    },
    "candidate_binding": {
      "$ref": "#/$defs/ActionPreparationBinding"
    },
    "evidence_id": {
      "$ref": "#/$defs/EvidenceId"
    },
    "origin_signature": {
      "description": "CP origin attestation under a dedicated purpose, never dispatch authority.",
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "candidate_binding",
    "agent_result",
    "origin_signature"
  ],
  "title": "ActionPreparationEvidence",
  "type": "object"
}
