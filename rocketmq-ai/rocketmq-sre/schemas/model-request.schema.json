{
  "$defs": {
    "CorrelationId": {
      "description": "Identifier propagated across one logical SRE operation.",
      "format": "uuid",
      "type": "string"
    },
    "ModelContentPart": {
      "description": "One typed content part in a canonical message.",
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "json",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "media_type": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/ModelImageSource"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "media_type",
            "source"
          ],
          "type": "object"
        },
        {
          "properties": {
            "call": {
              "$ref": "#/$defs/ModelToolCall"
            },
            "type": {
              "const": "tool_call",
              "type": "string"
            }
          },
          "required": [
            "type",
            "call"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": true,
            "is_error": {
              "type": "boolean"
            },
            "tool_call_id": {
              "type": "string"
            },
            "type": {
              "const": "tool_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_call_id",
            "content",
            "is_error"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "reasoning",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "ModelImageSource": {
      "description": "A provider-neutral image reference.\n\nData URLs are intentionally represented as references. The gateway's\nevidence preparation layer remains responsible for bounding and redacting\nimage data before it reaches this contract.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "url",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reference": {
              "type": "string"
            },
            "type": {
              "const": "data_reference",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reference"
          ],
          "type": "object"
        }
      ]
    },
    "ModelMessage": {
      "description": "Provider-neutral model message.\n\n`content` is retained as a compatibility convenience for text-only Phase 00\ncallers. New integrations should use typed `parts`; adapters merge the text\nfield and typed text parts deterministically.",
      "properties": {
        "content": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/ModelContentPart"
          },
          "type": "array"
        },
        "reasoning_content": {
          "description": "Provider-neutral reasoning channel. Profiles decide whether the\nprovider can receive or return this field.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/ModelRole"
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ModelToolCall"
          },
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "ModelRequestExtensions": {
      "description": "Explicit provider-profile-gated extensions.",
      "properties": {
        "kimi_mfjs": {
          "default": false,
          "description": "Kimi/Moonshot's MFJS mode. This is rejected unless the selected profile\nexplicitly declares MFJS support.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ModelRole": {
      "description": "Provider-neutral conversation role.",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "type": "string"
    },
    "ModelTool": {
      "description": "Read-only tool contract exposed to a model.",
      "properties": {
        "description": {
          "type": "string"
        },
        "input_schema": true,
        "mutates_cluster": {
          "description": "AI SRE model-visible tools must remain false in the read-only baseline.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "strict": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "mutates_cluster"
      ],
      "type": "object"
    },
    "ModelToolCall": {
      "description": "Provider-neutral tool call selected by a model.",
      "properties": {
        "arguments": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "type": "object"
    },
    "ResponseFormat": {
      "description": "Requested model response representation.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "json_object",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "schema": true,
            "strict": {
              "default": false,
              "type": "boolean"
            },
            "type": {
              "const": "json_schema",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "SchemaVersion": {
      "description": "Version negotiation information for a serialized contract family.",
      "properties": {
        "family": {
          "type": "string"
        },
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "required_features": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "family",
        "major",
        "minor"
      ],
      "type": "object"
    },
    "ToolChoice": {
      "description": "Provider-neutral tool selection policy.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "auto",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "required",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "specific",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical request before provider-specific translation.",
  "properties": {
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "extensions": {
      "$ref": "#/$defs/ModelRequestExtensions",
      "default": {
        "kimi_mfjs": false
      }
    },
    "max_output_tokens": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ModelMessage"
      },
      "type": "array"
    },
    "model": {
      "type": "string"
    },
    "reasoning": {
      "default": false,
      "type": "boolean"
    },
    "response_format": {
      "$ref": "#/$defs/ResponseFormat",
      "default": {
        "type": "text"
      }
    },
    "schema": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "stream": {
      "default": false,
      "type": "boolean"
    },
    "temperature_milli": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "tool_choice": {
      "$ref": "#/$defs/ToolChoice",
      "default": {
        "type": "auto"
      }
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ModelTool"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "correlation_id",
    "model",
    "messages"
  ],
  "title": "CanonicalModelRequest",
  "type": "object"
}
