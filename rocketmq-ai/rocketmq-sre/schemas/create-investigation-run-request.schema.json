{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationBudget": {
      "additionalProperties": false,
      "description": "Hard limits: retries are admissions and cannot create a fresh budget.",
      "properties": {
        "limit": {
          "$ref": "#/$defs/InvestigationBudgetCost"
        },
        "max_attempts_per_step": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "max_in_flight": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "max_query_retries": {
          "format": "uint8",
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        },
        "max_steps": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "max_steps",
        "max_in_flight",
        "max_attempts_per_step",
        "max_query_retries"
      ],
      "type": "object"
    },
    "InvestigationBudgetCost": {
      "additionalProperties": false,
      "description": "Conservatively reserved or actually consumed resources, shared across all steps.",
      "properties": {
        "evidence_items": {
          "format": "uint64",
          "maximum": 256,
          "minimum": 0,
          "type": "integer"
        },
        "model_calls": {
          "format": "uint64",
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "format": "uint64",
          "maximum": 4194304,
          "minimum": 0,
          "type": "integer"
        },
        "read_queries": {
          "format": "uint64",
          "maximum": 12,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "read_queries",
        "model_calls",
        "evidence_items",
        "output_bytes"
      ],
      "type": "object"
    },
    "InvestigationId": {
      "description": "Stable identifier for a multi-step investigation.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationPackRef": {
      "additionalProperties": false,
      "description": "Exact compiled pack version; neither a catalog entry nor a directory grants authority.",
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "pack_version": {
          "type": "string"
        }
      },
      "required": [
        "pack_id",
        "pack_version"
      ],
      "type": "object"
    },
    "InvestigationResource": {
      "additionalProperties": false,
      "description": "An investigation subject, not a canonical Evidence source resource or URL.",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "type": "object"
    },
    "InvestigationRunId": {
      "description": "Stable identifier for one bounded investigation run.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationRunScope": {
      "additionalProperties": false,
      "description": "Immutable authority boundary and requested absolute observation window.",
      "properties": {
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "investigation_id": {
          "$ref": "#/$defs/InvestigationId"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvestigationResource"
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "tenant_id",
        "cluster_id",
        "investigation_id",
        "time_range"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "description": "Resource classes accepted by the Phase 2 correlation engine.",
      "enum": [
        "cluster",
        "name_server",
        "controller",
        "broker",
        "proxy",
        "store",
        "topic",
        "queue",
        "consumer_group",
        "producer_group",
        "pod",
        "node",
        "persistent_volume_claim",
        "certificate",
        "runtime",
        "telemetry"
      ],
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    },
    "TimeRange": {
      "description": "Inclusive time range requested from an evidence source.",
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed creation body. D13 exports a contract, not an HTTP operation.",
  "properties": {
    "budget": {
      "$ref": "#/$defs/InvestigationBudget"
    },
    "deadline": {
      "format": "date-time",
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "packs": {
      "items": {
        "$ref": "#/$defs/InvestigationPackRef"
      },
      "type": "array"
    },
    "run_id": {
      "$ref": "#/$defs/InvestigationRunId"
    },
    "schema_version": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/InvestigationRunScope"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scope",
    "packs",
    "budget",
    "deadline",
    "idempotency_key"
  ],
  "title": "CreateInvestigationRunRequest",
  "type": "object"
}
