{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "DrActionItemId": {
      "description": "Stable identifier for an action item created from a disaster-recovery finding.",
      "format": "uuid",
      "type": "string"
    },
    "DrExerciseId": {
      "description": "Stable identifier for a disaster-recovery exercise.",
      "format": "uuid",
      "type": "string"
    },
    "DrFindingId": {
      "description": "Stable identifier for a disaster-recovery finding.",
      "format": "uuid",
      "type": "string"
    },
    "DrFindingSeverity": {
      "description": "Finding severity used by a DR exercise.",
      "enum": [
        "info",
        "warning",
        "blocker"
      ],
      "type": "string"
    },
    "DrFindingStatus": {
      "description": "Lifecycle for a DR finding.",
      "enum": [
        "open",
        "accepted",
        "resolved"
      ],
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Evidence-backed recovery finding.",
  "properties": {
    "action_item_id": {
      "$ref": "#/$defs/DrActionItemId"
    },
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array"
    },
    "exercise_id": {
      "$ref": "#/$defs/DrExerciseId"
    },
    "id": {
      "$ref": "#/$defs/DrFindingId"
    },
    "remediation": {
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "$ref": "#/$defs/DrFindingSeverity"
    },
    "status": {
      "$ref": "#/$defs/DrFindingStatus"
    },
    "summary": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "id",
    "exercise_id",
    "tenant_id",
    "code",
    "severity",
    "summary",
    "remediation",
    "evidence_ids",
    "status",
    "action_item_id",
    "created_at"
  ],
  "title": "DrFinding",
  "type": "object"
}
