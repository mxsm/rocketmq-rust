{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "GovernanceImpactKind": {
      "description": "Object type that currently depends on a governed version.",
      "enum": [
        "cluster",
        "diagnostic_pack",
        "action_plan",
        "action",
        "incident",
        "model_route",
        "integration"
      ],
      "type": "string"
    },
    "GovernanceVersionId": {
      "description": "Stable identifier for an immutable governed artifact version.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bounded reverse reference used by the impact view.",
  "properties": {
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/$defs/GovernanceImpactKind"
    },
    "label": {
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "version_id": {
      "$ref": "#/$defs/GovernanceVersionId"
    }
  },
  "required": [
    "version_id",
    "tenant_id",
    "kind",
    "reference_id",
    "label",
    "observed_at"
  ],
  "title": "GovernanceImpact",
  "type": "object"
}
