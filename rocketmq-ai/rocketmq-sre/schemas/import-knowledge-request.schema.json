{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "KnowledgeReviewStatus": {
      "description": "Knowledge review lifecycle.",
      "enum": [
        "draft",
        "in_review",
        "validated",
        "deprecated",
        "expired"
      ],
      "type": "string"
    },
    "Sensitivity": {
      "description": "Data handling classification applied before evidence leaves its source.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Direct import declaration; human/AI flags are caller declarations, not identity proof.",
  "properties": {
    "ai_generated": {
      "default": false,
      "type": "boolean"
    },
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "component": {
      "type": "string"
    },
    "human_validated": {
      "default": false,
      "type": "boolean"
    },
    "markdown": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "review_due_at": {
      "format": "date-time",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/KnowledgeReviewStatus",
      "default": "draft"
    },
    "rocketmq_version_range": {
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/Sensitivity"
    },
    "source_uri": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "valid_until": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "title",
    "component",
    "rocketmq_version_range",
    "source_uri",
    "source_version",
    "owner",
    "review_due_at",
    "sensitivity",
    "markdown"
  ],
  "title": "ImportKnowledgeRequest",
  "type": "object"
}
