{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "KnowledgeItemId": {
      "description": "Stable identifier for a knowledge item.",
      "format": "uuid",
      "type": "string"
    },
    "KnowledgeReviewStatus": {
      "description": "Knowledge review lifecycle.",
      "enum": [
        "draft",
        "in_review",
        "validated",
        "deprecated",
        "expired"
      ],
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Searchable, source-backed knowledge item.",
  "properties": {
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "component": {
      "type": "string"
    },
    "conflict": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/KnowledgeItemId"
    },
    "owner": {
      "type": "string"
    },
    "review_due_at": {
      "format": "date-time",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/KnowledgeReviewStatus"
    },
    "rocketmq_version_range": {
      "type": "string"
    },
    "sensitivity": {
      "type": "string"
    },
    "source_uri": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "valid_until": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "tenant_id",
    "title",
    "component",
    "rocketmq_version_range",
    "source_uri",
    "source_version",
    "owner",
    "review_status",
    "review_due_at",
    "sensitivity",
    "content_hash",
    "conflict",
    "created_at",
    "updated_at"
  ],
  "title": "KnowledgeItem",
  "type": "object"
}
