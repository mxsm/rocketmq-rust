{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "IncidentId": {
      "description": "Stable identifier for an SRE incident.",
      "format": "uuid",
      "type": "string"
    },
    "OperationsFinding": {
      "description": "One bounded, sanitized item in a handoff or operations report.",
      "properties": {
        "category": {
          "type": "string"
        },
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "deep_link": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "incident_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string"
        },
        "suggested_owner": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "severity",
        "title",
        "cluster_id",
        "detail",
        "suggested_owner",
        "observed_at",
        "deep_link"
      ],
      "type": "object"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Shift-change read model assembled from current operational state.",
  "properties": {
    "capacity_risks": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "expiring_certificates": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "new_incidents": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "overdue_action_items": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "partial": {
      "type": "boolean"
    },
    "recent_changes": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "risk_trends": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "source_gaps": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "unresolved_incidents": {
      "items": {
        "$ref": "#/$defs/OperationsFinding"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "window_start": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "window_start",
    "generated_at",
    "new_incidents",
    "unresolved_incidents",
    "risk_trends",
    "recent_changes",
    "expiring_certificates",
    "capacity_risks",
    "overdue_action_items",
    "source_gaps",
    "partial",
    "warnings"
  ],
  "title": "ShiftHandoffSummary",
  "type": "object"
}
