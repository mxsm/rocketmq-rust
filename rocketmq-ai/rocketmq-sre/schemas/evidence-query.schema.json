{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "CorrelationId": {
      "description": "Identifier propagated across one logical SRE operation.",
      "format": "uuid",
      "type": "string"
    },
    "QueryId": {
      "description": "Stable identifier for an evidence query.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    },
    "TimeRange": {
      "description": "Inclusive time range requested from an evidence source.",
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical read-only request for evidence.",
  "properties": {
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "query_id": {
      "$ref": "#/$defs/QueryId"
    },
    "resource": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "time_range": {
      "$ref": "#/$defs/TimeRange"
    }
  },
  "required": [
    "query_id",
    "correlation_id",
    "tenant_id",
    "cluster_id",
    "source",
    "resource",
    "time_range"
  ],
  "title": "EvidenceQuery",
  "type": "object"
}
