{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "DiagnosticEvidenceQuality": {
      "description": "Quality of the bounded stored sample selected for one diagnostic requirement.",
      "enum": [
        "available",
        "partial",
        "missing",
        "stale",
        "unknown",
        "unsupported"
      ],
      "type": "string"
    },
    "DiagnosticRequirementQuality": {
      "description": "IDs identify the exact stored sample that produced this assessment.\n\nAn unbound cluster projection does not establish revision membership.\nConsumers showing revision quality must require the requested investigation\nand revision binding, intersect these IDs with saved references, and verify\nresource and time scope.",
      "properties": {
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/EvidenceId"
          },
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/EvidenceFieldContract"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "max_age_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "$ref": "#/$defs/DiagnosticEvidenceQuality"
        },
        "reason_code": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "resource_prefix": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "resource_prefix",
        "required",
        "max_age_seconds",
        "fields",
        "quality",
        "reason_code",
        "evidence_ids",
        "missing_fields"
      ],
      "type": "object"
    },
    "EvidenceFieldContract": {
      "description": "A field contract describes evidence sufficiency; it grants no execution authority.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceFieldKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "type": "object"
    },
    "EvidenceFieldKind": {
      "description": "Primitive shape required by a compiled diagnostic predicate.",
      "enum": [
        "boolean",
        "number",
        "text"
      ],
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationControlEpoch": {
      "description": "Control generation, serialized as a lossless decimal string.",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "type": "string"
    },
    "InvestigationDiagnosisStatus": {
      "description": "Outcome of a deterministic diagnostic pack evaluated for an investigation.",
      "enum": [
        "healthy",
        "fault",
        "inconclusive",
        "unsupported"
      ],
      "type": "string"
    },
    "InvestigationId": {
      "description": "Stable identifier for a multi-step investigation.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationPackRef": {
      "additionalProperties": false,
      "description": "Exact compiled pack version; neither a catalog entry nor a directory grants authority.",
      "properties": {
        "pack_id": {
          "type": "string"
        },
        "pack_version": {
          "type": "string"
        }
      },
      "required": [
        "pack_id",
        "pack_version"
      ],
      "type": "object"
    },
    "InvestigationResource": {
      "additionalProperties": false,
      "description": "An investigation subject, not a canonical Evidence source resource or URL.",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "type": "object"
    },
    "InvestigationRunFinding": {
      "additionalProperties": false,
      "description": "Deterministic rule output. Model prose cannot replace these findings or\npromote missing/counter evidence into a root-cause statement.",
      "properties": {
        "counter_evidence_ids": {
          "items": {
            "$ref": "#/$defs/EvidenceId"
          },
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/InvestigationDiagnosisStatus"
        },
        "reason_code": {
          "type": "string"
        },
        "root_cause": {
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "$ref": "#/$defs/EvidenceId"
          },
          "type": "array"
        }
      },
      "required": [
        "reason_code",
        "root_cause",
        "outcome",
        "supporting_evidence_ids",
        "counter_evidence_ids"
      ],
      "type": "object"
    },
    "InvestigationRunId": {
      "description": "Stable identifier for one bounded investigation run.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationRunRevisionId": {
      "description": "Identifier of a saved run-owned diagnostic revision, independent of chat revisions.",
      "format": "uuid",
      "type": "string"
    },
    "InvestigationRunScope": {
      "additionalProperties": false,
      "description": "Immutable authority boundary and requested absolute observation window.",
      "properties": {
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "investigation_id": {
          "$ref": "#/$defs/InvestigationId"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvestigationResource"
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "tenant_id",
        "cluster_id",
        "investigation_id",
        "time_range"
      ],
      "type": "object"
    },
    "InvestigationStepId": {
      "description": "Stable identity for one read-only investigation step.",
      "format": "uuid",
      "type": "string"
    },
    "ResourceKind": {
      "description": "Resource classes accepted by the Phase 2 correlation engine.",
      "enum": [
        "cluster",
        "name_server",
        "controller",
        "broker",
        "proxy",
        "store",
        "topic",
        "queue",
        "consumer_group",
        "producer_group",
        "pod",
        "node",
        "persistent_volume_claim",
        "certificate",
        "runtime",
        "telemetry"
      ],
      "type": "string"
    },
    "StepAttemptId": {
      "description": "Stable identifier for one admitted investigation step attempt.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    },
    "TimeRange": {
      "description": "Inclusive time range requested from an evidence source.",
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Run-owned immutable diagnosis, without synthetic conversation/turn/answer IDs.\nIt must be inserted in the fenced evaluation-settlement transaction.",
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/StepAttemptId"
    },
    "control_epoch": {
      "$ref": "#/$defs/InvestigationControlEpoch"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/InvestigationRunFinding"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/InvestigationRunRevisionId"
    },
    "input_fingerprint": {
      "type": "string"
    },
    "pack": {
      "$ref": "#/$defs/InvestigationPackRef"
    },
    "partial": {
      "type": "boolean"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/DiagnosticRequirementQuality"
      },
      "type": "array"
    },
    "run_id": {
      "$ref": "#/$defs/InvestigationRunId"
    },
    "schema_version": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/InvestigationRunScope"
    },
    "status": {
      "$ref": "#/$defs/InvestigationDiagnosisStatus"
    },
    "step_id": {
      "$ref": "#/$defs/InvestigationStepId"
    }
  },
  "required": [
    "schema_version",
    "id",
    "run_id",
    "scope",
    "control_epoch",
    "pack",
    "step_id",
    "attempt_id",
    "status",
    "partial",
    "input_fingerprint",
    "evidence_ids",
    "requirements",
    "findings",
    "created_at"
  ],
  "title": "SavedInvestigationRunRevision",
  "type": "object"
}
