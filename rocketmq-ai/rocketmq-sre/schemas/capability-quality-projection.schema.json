{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityQualityProjection",
  "description": "Cluster-scoped capability facts evaluated against bounded, already saved evidence.\n\n`observed_at` is the evaluation instant. Evidence freshness is compared with\neach requirement's compiled age bound. This response never authorizes an action;\n`execution_eligible` is always false. Verification remains unknown without an\nexplicit deployment verification record.",
  "type": "object",
  "properties": {
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_eligible": {
      "type": "boolean"
    },
    "investigation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/InvestigationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticPackQuality"
      }
    },
    "partial": {
      "type": "boolean"
    },
    "revision_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosisRevisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiagnosticScenarioCoverage"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "observed_at",
    "execution_eligible",
    "partial",
    "packs",
    "scenarios"
  ],
  "$defs": {
    "CapabilityFact": {
      "description": "One independently sourced fact, rather than an aggregate authorization decision.",
      "type": "object",
      "properties": {
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason_code": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CapabilityFactStatus"
        }
      },
      "required": [
        "status",
        "reason_code",
        "source_ref"
      ]
    },
    "CapabilityFactStatus": {
      "description": "Whether a particular capability fact has actually been established.",
      "type": "string",
      "enum": [
        "present",
        "absent",
        "unknown",
        "not_applicable"
      ]
    },
    "CapabilityLayers": {
      "description": "Registration, implementation, deployment, observation and verification stay independent.",
      "type": "object",
      "properties": {
        "configured": {
          "$ref": "#/$defs/CapabilityFact"
        },
        "handler": {
          "$ref": "#/$defs/CapabilityFact"
        },
        "production_verified": {
          "$ref": "#/$defs/CapabilityFact"
        },
        "registered": {
          "$ref": "#/$defs/CapabilityFact"
        },
        "target_observed": {
          "$ref": "#/$defs/CapabilityFact"
        },
        "test_verified": {
          "$ref": "#/$defs/CapabilityFact"
        }
      },
      "required": [
        "registered",
        "handler",
        "configured",
        "target_observed",
        "test_verified",
        "production_verified"
      ]
    },
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "type": "string",
      "format": "uuid"
    },
    "DiagnosisRevisionId": {
      "description": "Stable identifier for an immutable diagnosis revision.",
      "type": "string",
      "format": "uuid"
    },
    "DiagnosticEvidenceQuality": {
      "description": "Quality of the bounded stored sample selected for one diagnostic requirement.",
      "type": "string",
      "enum": [
        "available",
        "partial",
        "missing",
        "stale",
        "unknown",
        "unsupported"
      ]
    },
    "DiagnosticPackQuality": {
      "description": "Read-only evidence sufficiency for a compiled diagnostic pack.",
      "type": "object",
      "properties": {
        "layers": {
          "$ref": "#/$defs/CapabilityLayers"
        },
        "pack_id": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosticRequirementQuality"
          }
        }
      },
      "required": [
        "pack_id",
        "layers",
        "requirements"
      ]
    },
    "DiagnosticRequirementQuality": {
      "description": "IDs identify the exact stored sample that produced this assessment.\n\nThis cluster projection does not bind a diagnosis revision. A consumer\nshowing revision quality must intersect these IDs with that revision's\nsaved references and verify its resource and time scope.",
      "type": "object",
      "properties": {
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceFieldContract"
          }
        },
        "id": {
          "type": "string"
        },
        "max_age_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "quality": {
          "$ref": "#/$defs/DiagnosticEvidenceQuality"
        },
        "reason_code": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "resource_prefix": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "resource_prefix",
        "required",
        "max_age_seconds",
        "fields",
        "quality",
        "reason_code",
        "evidence_ids",
        "missing_fields"
      ]
    },
    "DiagnosticScenarioCoverage": {
      "description": "A documented comparison of packs, never a claimed causal relationship between samples.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "pack_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_signal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "pack_ids",
        "required_signal_ids"
      ]
    },
    "EvidenceFieldContract": {
      "description": "A field contract describes evidence sufficiency; it grants no execution authority.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceFieldKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ]
    },
    "EvidenceFieldKind": {
      "description": "Primitive shape required by a compiled diagnostic predicate.",
      "type": "string",
      "enum": [
        "boolean",
        "number",
        "text"
      ]
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "type": "string",
      "format": "uuid"
    },
    "InvestigationId": {
      "description": "Stable identifier for a multi-step investigation.",
      "type": "string",
      "format": "uuid"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "type": "string",
      "format": "uuid"
    }
  }
}
