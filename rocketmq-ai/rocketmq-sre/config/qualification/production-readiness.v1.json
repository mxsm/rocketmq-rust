    "soak_runner": "rocketmq-ai/rocketmq-sre/scripts/phase05-soak-chaos.ps1",
    "scale_runner": "rocketmq-ai/rocketmq-sre/scripts/phase05-enterprise-smoke.ps1",
    "postgres_ha_runner": "rocketmq-ai/rocketmq-sre/scripts/docker-infrastructure-recovery-smoke.ps1",
    "disaster_recovery_runner": "rocketmq-ai/rocketmq-sre/scripts/disaster-recovery-qualification.ps1",
    "service_image_contract": "scripts/service-image-contract.ps1",
