{
  "$defs": {
    "ActionPlanId": {
      "description": "Stable identifier for an immutable action plan.",
      "format": "uuid",
      "type": "string"
    },
    "ChangeScheduleId": {
      "description": "Stable identifier for a scheduled runbook execution.",
      "format": "uuid",
      "type": "string"
    },
    "ChangeScheduleStatus": {
      "description": "Durable scheduler lifecycle.",
      "enum": [
        "scheduled",
        "running",
        "awaiting_manual_gate",
        "paused",
        "safe_stopping",
        "reconciling",
        "completed",
        "cancelled",
        "rejected"
      ],
      "type": "string"
    },
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "CorrelationId": {
      "description": "Identifier propagated across one logical SRE operation.",
      "format": "uuid",
      "type": "string"
    },
    "ExecutionId": {
      "description": "Stable identifier for a supervised execution.",
      "format": "uuid",
      "type": "string"
    },
    "RunbookId": {
      "description": "Stable identifier for a versioned change runbook.",
      "format": "uuid",
      "type": "string"
    },
    "RunbookStepId": {
      "description": "Stable identifier for a typed runbook step.",
      "format": "uuid",
      "type": "string"
    },
    "RunbookStepPlanBinding": {
      "additionalProperties": false,
      "description": "Immutable binding from one typed runbook action to one approved plan.",
      "properties": {
        "plan_hash": {
          "type": "string"
        },
        "plan_id": {
          "$ref": "#/$defs/ActionPlanId"
        },
        "precondition_hash": {
          "type": "string"
        },
        "step_id": {
          "$ref": "#/$defs/RunbookStepId"
        }
      },
      "required": [
        "step_id",
        "plan_id",
        "plan_hash",
        "precondition_hash"
      ],
      "type": "object"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Scheduled runbook execution.",
  "properties": {
    "active_execution_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancel_requested_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "completed_steps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunbookStepId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/ChangeScheduleId"
    },
    "intent_persisted": {
      "type": "boolean"
    },
    "next_step_sequence": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "pause_requested_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "plan_bindings": {
      "items": {
        "$ref": "#/$defs/RunbookStepPlanBinding"
      },
      "type": "array"
    },
    "resource_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "runbook_id": {
      "$ref": "#/$defs/RunbookId"
    },
    "runbook_version": {
      "type": "string"
    },
    "scheduled_end": {
      "format": "date-time",
      "type": "string"
    },
    "scheduled_start": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ChangeScheduleStatus"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "waiting_manual_gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunbookStepId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "cluster_id",
    "correlation_id",
    "runbook_id",
    "runbook_version",
    "plan_bindings",
    "scheduled_start",
    "scheduled_end",
    "status",
    "intent_persisted",
    "next_step_sequence",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "title": "ChangeSchedule",
  "type": "object"
}
