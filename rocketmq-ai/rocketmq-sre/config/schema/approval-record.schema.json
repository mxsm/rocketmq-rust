{
  "$defs": {
    "ActionPlanId": {
      "description": "Stable identifier for an immutable action plan.",
      "format": "uuid",
      "type": "string"
    },
    "ApprovalDecision": {
      "description": "Human approval outcome.",
      "enum": [
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "ApprovalId": {
      "description": "Stable identifier for an approval decision.",
      "format": "uuid",
      "type": "string"
    },
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Append-only human decision bound to one exact plan hash.",
  "properties": {
    "approver_role": {
      "type": "string"
    },
    "approver_subject": {
      "type": "string"
    },
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "decided_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/ApprovalId"
    },
    "plan_hash": {
      "type": "string"
    },
    "plan_id": {
      "$ref": "#/$defs/ActionPlanId"
    },
    "reason": {
      "type": "string"
    },
    "requester_subject": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "id",
    "plan_id",
    "plan_hash",
    "tenant_id",
    "cluster_id",
    "requester_subject",
    "approver_subject",
    "approver_role",
    "decision",
    "reason",
    "decided_at",
    "expires_at"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
