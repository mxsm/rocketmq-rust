{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "CorrelationId": {
      "description": "Identifier propagated across one logical SRE operation.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic technical-SLI projection returned to the Executor.",
  "properties": {
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "complete": {
      "type": "boolean"
    },
    "conditions": {
      "additionalProperties": {
        "type": "boolean"
      },
      "type": "object"
    },
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "cluster_id",
    "correlation_id",
    "conditions",
    "complete",
    "observed_at"
  ],
  "title": "ExecutionSliObservation",
  "type": "object"
}
