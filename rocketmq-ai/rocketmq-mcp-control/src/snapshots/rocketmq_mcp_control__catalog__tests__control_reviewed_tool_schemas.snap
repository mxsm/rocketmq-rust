          ],
          "type": "object"
        },
        "ConsumerGroupReplacement": {
          "additionalProperties": false,
          "properties": {
            "broker_id": {
              "description": "Id of the Broker the group normally consumes from; 0 is the master.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "consume_broadcast_enable": {
              "description": "Whether the group may consume in broadcast mode.",
              "type": "boolean"
            },
            "consume_enable": {
              "description": "Whether the group may consume messages.",
              "type": "boolean"
            },
            "consume_from_min_enable": {
              "description": "Whether the group may start consuming from the minimum offset of a queue.",
              "type": "boolean"
            },
            "consume_message_orderly": {
              "description": "Whether the group consumes messages in order.",
              "type": "boolean"
            },
            "consume_timeout_minute": {
              "description": "Minutes after which an unacknowledged message counts as timed out, 1 to 10080.",
              "format": "int32",
              "maximum": 10080,
              "minimum": 1,
              "type": "integer"
            },
            "group_sys_flag": {
              "description": "System flag bits of the group; 0 for an ordinary group.",
              "format": "int32",
              "type": "integer"
            },
            "notify_consumer_ids_changed_enable": {
              "description": "Whether consumers are notified when the membership of the group changes.",
              "type": "boolean"
            },
            "retry_max_times": {
              "description": "Maximum number of redeliveries of a message, -1 to 10000.",
              "format": "int32",
              "maximum": 10000,
              "minimum": -1,
              "type": "integer"
            },
            "retry_queue_nums": {
              "description": "Number of retry queues, 0 to 127.",
              "format": "int32",
              "maximum": 127,
              "minimum": 0,
              "type": "integer"
            },
            "which_broker_when_consume_slowly": {
              "description": "Id of the Broker that consumers are redirected to when consuming from the master is slow.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "consume_enable",
            "consume_from_min_enable",
            "consume_broadcast_enable",
            "consume_message_orderly",
            "retry_queue_nums",
            "retry_max_times",
            "broker_id",
            "which_broker_when_consume_slowly",
            "notify_consumer_ids_changed_enable",
            "group_sys_flag",
            "consume_timeout_minute"
          ],
          "type": "object"
        },
        "ConsumerGroupUpsertOperation": {
          "const": "consumer_group_upsert",
          "type": "string"
        },
        "ControlErrorCode": {
          "enum": [
            "invalid_config",
            "request_rejected",
            "unauthorized",
            "permission_denied",
            "cluster_not_allowed",
            "operation_not_allowed",
