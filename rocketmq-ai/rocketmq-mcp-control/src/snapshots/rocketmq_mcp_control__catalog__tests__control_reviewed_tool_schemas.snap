  {
    "name": "rocketmq_upsert_consumer_group",
    "title": "Upsert RocketMQ consumer group",
    "description": "Dry-run or conditionally replace a complete Consumer Group configuration on selected cluster masters.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "broker_id": {
          "description": "Id of the Broker the group normally consumes from; 0 is the master.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "broker_names": {
          "description": "Logical names of the master Brokers to change, 1 to 64 distinct names; never addresses. Each must belong to the selected cluster.",
          "items": {
            "maxLength": 127,
            "minLength": 1,
            "pattern": "^[%|a-zA-Z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "cluster": {
          "description": "Logical cluster name from the server configuration, never a NameServer or Broker address. Both the caller and the server policy must allow it.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "confirm": {
          "default": false,
          "description": "Explicit confirmation. Must be true to execute, that is when `dry_run` is false; a dry run does not need it.",
          "type": "boolean"
        },
        "consume_broadcast_enable": {
          "description": "Whether the group may consume in broadcast mode.",
          "type": "boolean"
        },
        "consume_enable": {
          "description": "Whether the group may consume messages.",
          "type": "boolean"
        },
        "consume_from_min_enable": {
          "description": "Whether the group may start consuming from the minimum offset of a queue.",
          "type": "boolean"
        },
        "consume_message_orderly": {
          "description": "Whether the group consumes messages in order.",
          "type": "boolean"
        },
        "consume_timeout_minute": {
          "description": "Minutes after which an unacknowledged message counts as timed out, 1 to 10080.",
          "format": "int32",
          "maximum": 10080,
          "minimum": 1,
          "type": "integer"
        },
        "consumer_group": {
          "description": "Consumer Group to create or replace: letters, digits, `%`, `|`, `_` and `-`, at most 255 characters. RocketMQ's built-in system groups are rejected.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[%|a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "dry_run": {
          "default": true,
          "description": "Plan only: read the current state and report what would change, without writing. When omitted, the server's configured default applies, which is a dry run unless the operator changed it.",
          "type": "boolean"
        },
        "group_sys_flag": {
          "description": "System flag bits of the group; 0 for an ordinary group.",
          "format": "int32",
          "type": "integer"
        },
        "notify_consumer_ids_changed_enable": {
          "description": "Whether consumers are notified when the membership of the group changes.",
          "type": "boolean"
        },
        "reason": {
          "default": null,
          "description": "Why the change is made; kept only in the durable audit log. Required to execute. 5 to 256 characters of letters, digits, spaces and `._,#-`, without addresses, host names or tokens.",
          "maxLength": 256,
          "minLength": 5,
          "type": [
            "string",
            "null"
          ]
        },
        "request_key": {
          "default": null,
          "description": "Optional idempotency key of 8 to 64 letters, digits and `._:-`. An execute call that repeats a key with the same arguments returns the outcome already recorded for it instead of writing again; the same key with different arguments is rejected.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9._:-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "retry_max_times": {
          "description": "Maximum number of redeliveries of a message, -1 to 10000.",
          "format": "int32",
          "maximum": 10000,
          "minimum": -1,
          "type": "integer"
        },
        "retry_queue_nums": {
          "description": "Number of retry queues, 0 to 127.",
          "format": "int32",
          "maximum": 127,
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "description": "Version of this argument schema. Always `rocketmq-mcp-control.arguments.v1`.",
          "pattern": "^rocketmq-mcp-control\\.arguments\\.v1$",
          "type": "string"
        },
        "which_broker_when_consume_slowly": {
          "description": "Id of the Broker that consumers are redirected to when consuming from the master is slow.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "cluster",
        "consumer_group",
        "broker_names",
        "consume_enable",
        "consume_from_min_enable",
        "consume_broadcast_enable",
        "consume_message_orderly",
        "retry_queue_nums",
        "retry_max_times",
        "broker_id",
        "which_broker_when_consume_slowly",
        "notify_consumer_ids_changed_enable",
        "group_sys_flag",
        "consume_timeout_minute"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ConsumerGroupMutationResource": {
          "additionalProperties": false,
          "properties": {
            "brokers": {
