  {
    "name": "rocketmq_set_broker_log_filter_ttl",
    "title": "Set temporary RocketMQ Broker log level",
    "description": "Dry-run or set one rocketmq_broker:: logger of one Broker master to INFO or DEBUG for 60 to 900 seconds. The Broker returns to its startup log filter by itself when the time is up; rocketmq_restore_broker_log_filter ends the override earlier.",
    "inputSchema": {
      "$defs": {
        "BrokerLogLevel": {
          "description": "The levels a temporary override can give a logger.",
          "enum": [
            "INFO",
            "DEBUG"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "broker_name": {
          "description": "Logical name of the Broker whose master gets the override; never an address.",
          "maxLength": 127,
          "minLength": 1,
          "pattern": "^[%|a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "cluster": {
          "description": "Logical cluster name from the server configuration, never a NameServer or Broker address. Both the caller and the server policy must allow it.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "confirm": {
          "default": false,
          "description": "Explicit confirmation. Must be true to execute, that is when `dry_run` is false; a dry run does not need it.",
          "type": "boolean"
        },
        "dry_run": {
          "default": true,
          "description": "Plan only: read the current state and report what would change, without writing. When omitted, the server's configured default applies, which is a dry run unless the operator changed it.",
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/BrokerLogLevel",
          "description": "Level the logger gets until the override ends."
        },
        "logger": {
          "description": "Logger to change: a lower-case `rocketmq_broker::` module path such as `rocketmq_broker::processor`, at most 128 characters. Loggers of modules that handle message content, credentials or storage are rejected.",
          "maxLength": 128,
          "minLength": 18,
          "pattern": "^rocketmq_broker(::[a-z_][a-z0-9_]*)+$",
          "type": "string"
        },
        "operation_id": {
          "description": "Identifier you choose for this override: 8 to 64 letters, digits, `_` and `-`. The Broker keeps it while the override is active, and `rocketmq_restore_broker_log_filter` must pass the same one.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "reason": {
          "default": null,
          "description": "Why the change is made; kept only in the durable audit log. Required to execute. 5 to 256 characters of letters, digits, spaces and `._,#-`, without addresses, host names or tokens.",
          "maxLength": 256,
          "minLength": 5,
          "type": [
            "string",
            "null"
          ]
        },
        "request_key": {
          "default": null,
          "description": "Optional idempotency key of 8 to 64 letters, digits and `._:-`. An execute call that repeats a key with the same arguments returns the outcome already recorded for it instead of writing again; the same key with different arguments is rejected.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9._:-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "description": "Version of this argument schema. Always `rocketmq-mcp-control.arguments.v1`.",
          "pattern": "^rocketmq-mcp-control\\.arguments\\.v1$",
          "type": "string"
        },
        "ttl_seconds": {
          "description": "Seconds after which the Broker ends the override by itself, 60 to 900.",
          "format": "uint32",
          "maximum": 900,
          "minimum": 60,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "cluster",
        "broker_name",
        "logger",
        "level",
        "ttl_seconds",
        "operation_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "BrokerLogFilterOperation": {
          "const": "broker_log_filter_set",
          "type": "string"
        },
        "BrokerLogFilterRequested": {
          "oneOf": [
            {
              "properties": {
                "action": {
                  "const": "set",
                  "type": "string"
                },
                "level": {
                  "$ref": "#/$defs/BrokerLogLevel"
                },
                "logger": {
                  "type": "string"
                },
                "ttl_seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "action",
                "logger",
                "level",
                "ttl_seconds"
              ],
              "type": "object"
            },
            {
              "properties": {
                "action": {
                  "const": "restore",
                  "type": "string"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            }
          ]
        },
        "BrokerLogFilterResource": {
          "additionalProperties": false,
          "properties": {
            "broker_name": {
              "type": "string"
            }
          },
          "required": [
            "broker_name"
          ],
          "type": "object"
        },
        "BrokerLogFilterState": {
