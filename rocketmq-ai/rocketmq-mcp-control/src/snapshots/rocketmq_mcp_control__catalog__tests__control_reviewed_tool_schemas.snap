          "type": "string"
        },
        "FailureCode": {
          "enum": [
            "conflict",
            "invalid_data",
            "unavailable",
            "persistence_failed",
            "verification_failed",
            "order_reconciliation_failed"
          ],
          "type": "string"
        },
        "MutationMode": {
          "enum": [
            "dry_run",
            "execute"
          ],
          "type": "string"
        },
        "MutationResultSchemaVersion": {
          "const": "rocketmq-mcp-mutation.v1",
          "type": "string"
        },
        "MutationStatus": {
          "enum": [
            "planned",
            "applied",
            "partial",
            "conflict",
            "failed"
          ],
          "type": "string"
        },
        "OperationHolder": {
          "description": "Which operation holds a target, told without its identifier.\n\nThe identifier of an operation that another call started is that caller's text, so a response never repeats it.",
          "oneOf": [
            {
              "const": "none",
              "description": "No operation holds the target.",
              "type": "string"
            },
            {
              "const": "this_operation",
              "description": "The operation that this call names by its `operation_id`.",
              "type": "string"
            },
            {
              "const": "other_operation",
              "description": "An operation with another identifier.",
              "type": "string"
            }
          ]
        },
        "ProxyDrainAction": {
          "enum": [
            "begin",
            "cancel"
          ],
          "type": "string"
        },
        "ProxyDrainOperation": {
          "const": "proxy_drain_cancel",
          "type": "string"
        },
        "ProxyDrainPending": {
          "additionalProperties": false,
          "description": "Work that a Proxy still holds; every member is zero once it is drained.",
          "properties": {
            "active_connections": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "prepared_transactions": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "receipt_handles": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "remoting_channels": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "rpc_in_flight": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "sessions": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "telemetry_commands": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "telemetry_links": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "active_connections",
            "sessions",
            "receipt_handles",
            "prepared_transactions",
            "telemetry_links",
            "remoting_channels",
            "telemetry_commands",
            "rpc_in_flight"
          ],
          "type": "object"
        },
        "ProxyDrainPhase": {
          "oneOf": [
            {
              "const": "accepting",
              "description": "The Proxy admits work.",
              "type": "string"
            },
            {
              "const": "draining",
              "description": "The Proxy admits no new work and still has work pending.",
              "type": "string"
            },
            {
              "const": "drained",
              "description": "The Proxy admits no new work and has none pending, so it can be restarted.",
              "type": "string"
            }
          ]
        },
        "ProxyDrainRequested": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/ProxyDrainAction"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "ProxyDrainResource": {
          "additionalProperties": false,
          "properties": {
            "proxy_name": {
              "type": "string"
            }
          },
          "required": [
            "proxy_name"
          ],
          "type": "object"
        },
        "ProxyDrainState": {
          "additionalProperties": false,
          "properties": {
            "admission_open": {
              "type": "boolean"
            },
            "held_by": {
              "$ref": "#/$defs/OperationHolder",
