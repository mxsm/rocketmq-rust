  {
    "name": "rocketmq_begin_proxy_drain",
    "title": "Begin RocketMQ Proxy drain",
    "description": "Dry-run or begin a drain of one configured Proxy: it stops admitting new work so that it can be restarted once nothing is pending. The drain lasts until rocketmq_cancel_proxy_drain is called with the same operation_id.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "description": "Logical cluster name from the server configuration, never a NameServer or Broker address. Both the caller and the server policy must allow it.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "confirm": {
          "default": false,
          "description": "Explicit confirmation. Must be true to execute, that is when `dry_run` is false; a dry run does not need it.",
          "type": "boolean"
        },
        "dry_run": {
          "default": true,
          "description": "Plan only: read the current state and report what would change, without writing. When omitted, the server's configured default applies, which is a dry run unless the operator changed it.",
          "type": "boolean"
        },
        "operation_id": {
          "description": "Identifier of the drain: 8 to 64 letters, digits, `_` and `-`. The call that begins a drain chooses it and the Proxy keeps it while it drains; a call that cancels the drain must pass the same one.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "proxy_name": {
          "description": "Alias of the Proxy as the server configuration names it for this cluster; never an address.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "reason": {
          "default": null,
          "description": "Why the change is made; kept only in the durable audit log. Required to execute. 5 to 256 characters of letters, digits, spaces and `._,#-`, without addresses, host names or tokens.",
          "maxLength": 256,
          "minLength": 5,
          "type": [
            "string",
            "null"
          ]
        },
        "request_key": {
          "default": null,
          "description": "Optional idempotency key of 8 to 64 letters, digits and `._:-`. An execute call that repeats a key with the same arguments returns the outcome already recorded for it instead of writing again; the same key with different arguments is rejected.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9._:-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "description": "Version of this argument schema. Always `rocketmq-mcp-control.arguments.v1`.",
          "pattern": "^rocketmq-mcp-control\\.arguments\\.v1$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "cluster",
        "proxy_name",
        "operation_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ControlErrorCode": {
          "enum": [
            "invalid_config",
            "request_rejected",
            "unauthorized",
            "permission_denied",
            "cluster_not_allowed",
            "operation_not_allowed",
            "mutation_disabled",
            "operation_unavailable",
            "rate_limited",
            "confirmation_required",
            "invalid_argument",
            "audit_unavailable",
            "precondition_conflict",
            "partial_apply",
            "verification_failed",
            "timeout",
            "cancelled",
            "execution_failed",
            "shutdown_failed"
          ],
          "type": "string"
        },
        "FailureCode": {
          "enum": [
            "conflict",
            "invalid_data",
            "unavailable",
            "persistence_failed",
            "verification_failed",
            "order_reconciliation_failed"
          ],
          "type": "string"
        },
        "MutationMode": {
          "enum": [
            "dry_run",
            "execute"
          ],
          "type": "string"
        },
        "MutationResultSchemaVersion": {
          "const": "rocketmq-mcp-mutation.v1",
          "type": "string"
        },
        "MutationStatus": {
          "enum": [
            "planned",
            "applied",
            "partial",
            "conflict",
            "failed"
          ],
          "type": "string"
        },
        "OperationHolder": {
          "description": "Which operation holds a target, told without its identifier.\n\nThe identifier of an operation that another call started is that caller's text, so a response never repeats it.",
          "oneOf": [
            {
              "const": "none",
              "description": "No operation holds the target.",
              "type": "string"
            },
            {
              "const": "this_operation",
              "description": "The operation that this call names by its `operation_id`.",
              "type": "string"
            },
            {
              "const": "other_operation",
              "description": "An operation with another identifier.",
              "type": "string"
            }
          ]
        },
        "ProxyDrainAction": {
          "enum": [
            "begin",
            "cancel"
          ],
          "type": "string"
        },
        "ProxyDrainOperation": {
          "const": "proxy_drain_begin",
          "type": "string"
        },
        "ProxyDrainPending": {
          "additionalProperties": false,
          "description": "Work that a Proxy still holds; every member is zero once it is drained.",
          "properties": {
            "active_connections": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "prepared_transactions": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "receipt_handles": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "remoting_channels": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "rpc_in_flight": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "sessions": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "telemetry_commands": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "telemetry_links": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "active_connections",
            "sessions",
            "receipt_handles",
            "prepared_transactions",
            "telemetry_links",
            "remoting_channels",
            "telemetry_commands",
            "rpc_in_flight"
          ],
          "type": "object"
        },
        "ProxyDrainPhase": {
          "oneOf": [
            {
              "const": "accepting",
              "description": "The Proxy admits work.",
              "type": "string"
            },
            {
              "const": "draining",
              "description": "The Proxy admits no new work and still has work pending.",
              "type": "string"
            },
            {
              "const": "drained",
              "description": "The Proxy admits no new work and has none pending, so it can be restarted.",
              "type": "string"
            }
          ]
        },
        "ProxyDrainRequested": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/ProxyDrainAction"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "ProxyDrainResource": {
          "additionalProperties": false,
          "properties": {
            "proxy_name": {
              "type": "string"
            }
          },
          "required": [
            "proxy_name"
          ],
          "type": "object"
        },
        "ProxyDrainState": {
          "additionalProperties": false,
          "properties": {
            "admission_open": {
              "type": "boolean"
            },
            "held_by": {
              "$ref": "#/$defs/OperationHolder",
              "description": "Whether a drain holds the Proxy, and whether the `operation_id` of this call began it."
            },
            "pending": {
              "$ref": "#/$defs/ProxyDrainPending"
            },
            "phase": {
              "$ref": "#/$defs/ProxyDrainPhase"
            },
            "readiness_published": {
              "type": "boolean"
            },
            "routing_open": {
              "type": "boolean"
            },
            "zero_pending": {
              "type": "boolean"
            }
          },
          "required": [
            "phase",
            "held_by",
            "admission_open",
            "routing_open",
            "readiness_published",
            "zero_pending",
            "pending"
          ],
          "type": "object"
        },
        "ProxyDrainTarget": {
          "additionalProperties": false,
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProxyDrainState"
                },
                {
                  "type": "null"
                }
              ],
              "description": "State read after an execution; null for a dry run and when the Proxy could not be read again."
            },
            "applied": {
              "description": "Whether the Proxy acknowledged the action or already was in the requested state.",
              "type": "boolean"
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProxyDrainState"
                },
                {
                  "type": "null"
                }
              ],
              "description": "State read before the call changed anything; null when the Proxy could not be read."
            },
            "changed": {
              "description": "For a dry run, whether executing would change the Proxy; otherwise whether it changed.",
              "type": "boolean"
            },
            "failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FailureCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proxy_name": {
              "type": "string"
            },
            "requested": {
              "$ref": "#/$defs/ProxyDrainRequested"
            },
            "retryable": {
              "type": "boolean"
            },
            "verification": {
              "$ref": "#/$defs/VerificationState"
            }
          },
          "required": [
            "proxy_name",
            "before",
            "requested",
            "after",
            "applied",
            "changed",
            "verification",
            "failure",
            "retryable"
          ],
          "type": "object"
        },
        "VerificationState": {
          "enum": [
            "not_performed",
            "verified",
            "failed"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ProxyDrainState"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "additionalProperties": {
            "$ref": "#/$defs/ProxyDrainState"
          },
          "description": "State before the call, by Proxy alias; empty when the Proxy could not be read.",
          "type": "object"
        },
        "cluster": {
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation_id": {
          "description": "Identifies this call in the durable audit log. Pass it to rocketmq_get_mutation_result to read how the call ended.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/MutationMode"
        },
        "operation": {
          "$ref": "#/$defs/ProxyDrainOperation"
        },
        "requested": {
          "$ref": "#/$defs/ProxyDrainRequested"
        },
        "schema_version": {
