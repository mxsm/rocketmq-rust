        "targets",
        "warnings",
        "invocation_id"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Set temporary RocketMQ Broker log level",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "rocketmq_restore_broker_log_filter",
    "title": "Restore RocketMQ Broker log level",
    "description": "Dry-run or end the temporary log level that rocketmq_set_broker_log_filter_ttl set on one Broker master with the same operation_id, returning the Broker to its startup log filter. An override that another operation holds is left alone.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "broker_name": {
          "description": "Logical name of the Broker whose master holds the override; never an address.",
          "maxLength": 127,
          "minLength": 1,
          "pattern": "^[%|a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "cluster": {
          "description": "Logical cluster name from the server configuration, never a NameServer or Broker address. Both the caller and the server policy must allow it.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "confirm": {
          "default": false,
          "description": "Explicit confirmation. Must be true to execute, that is when `dry_run` is false; a dry run does not need it.",
          "type": "boolean"
        },
        "dry_run": {
          "default": true,
          "description": "Plan only: read the current state and report what would change, without writing. When omitted, the server's configured default applies, which is a dry run unless the operator changed it.",
          "type": "boolean"
        },
        "operation_id": {
          "description": "Identifier the override was set with: 8 to 64 letters, digits, `_` and `-`. An override that another identifier holds is left alone.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "reason": {
          "default": null,
          "description": "Why the change is made; kept only in the durable audit log. Required to execute. 5 to 256 characters of letters, digits, spaces and `._,#-`, without addresses, host names or tokens.",
          "maxLength": 256,
          "minLength": 5,
          "type": [
            "string",
            "null"
          ]
        },
        "request_key": {
          "default": null,
          "description": "Optional idempotency key of 8 to 64 letters, digits and `._:-`. An execute call that repeats a key with the same arguments returns the outcome already recorded for it instead of writing again; the same key with different arguments is rejected.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9._:-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "description": "Version of this argument schema. Always `rocketmq-mcp-control.arguments.v1`.",
          "pattern": "^rocketmq-mcp-control\\.arguments\\.v1$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "cluster",
        "broker_name",
        "operation_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "BrokerLogFilterOperation": {
          "const": "broker_log_filter_restore",
          "type": "string"
        },
        "BrokerLogFilterRequested": {
          "oneOf": [
            {
              "properties": {
                "action": {
                  "const": "set",
                  "type": "string"
                },
                "level": {
                  "$ref": "#/$defs/BrokerLogLevel"
                },
                "logger": {
                  "type": "string"
                },
                "ttl_seconds": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "action",
                "logger",
                "level",
                "ttl_seconds"
              ],
              "type": "object"
            },
            {
              "properties": {
                "action": {
                  "const": "restore",
                  "type": "string"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            }
          ]
        },
        "BrokerLogFilterResource": {
          "additionalProperties": false,
          "properties": {
            "broker_name": {
              "type": "string"
            }
          },
          "required": [
            "broker_name"
          ],
          "type": "object"
        },
        "BrokerLogFilterState": {
          "additionalProperties": false,
          "properties": {
            "expires_at_millis": {
              "anyOf": [
                {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Unix time in milliseconds at which the Broker ends the active override by itself; null when none is active."
            },
            "held_by": {
              "$ref": "#/$defs/OperationHolder",
              "description": "Whether an override is active, and whether the `operation_id` of this call set it."
            },
            "level": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BrokerLogLevel"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Effective level of the logger a set names. Null for a restore, which names no logger, and when the level is neither `INFO` nor `DEBUG`."
            }
          },
          "required": [
            "level",
            "held_by",
            "expires_at_millis"
          ],
          "type": "object"
        },
        "BrokerLogFilterTarget": {
          "additionalProperties": false,
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BrokerLogFilterState"
                },
                {
                  "type": "null"
                }
              ],
              "description": "State read after an execution; null for a dry run and when the Broker could not be read again."
            },
            "applied": {
              "description": "Whether the Broker acknowledged the action or already was in the requested state.",
              "type": "boolean"
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BrokerLogFilterState"
                },
                {
                  "type": "null"
                }
              ],
              "description": "State read before the call changed anything; null when the Broker could not be read."
            },
            "broker_name": {
              "type": "string"
            },
            "changed": {
              "description": "For a dry run, whether executing would change the Broker; otherwise whether it changed.",
              "type": "boolean"
            },
            "failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FailureCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested": {
              "$ref": "#/$defs/BrokerLogFilterRequested"
            },
            "retryable": {
              "type": "boolean"
            },
            "verification": {
              "$ref": "#/$defs/VerificationState"
            }
          },
          "required": [
            "broker_name",
            "before",
            "requested",
            "after",
            "applied",
            "changed",
            "verification",
            "failure",
            "retryable"
          ],
          "type": "object"
        },
        "BrokerLogLevel": {
          "description": "The levels a temporary override can give a logger.",
          "enum": [
            "INFO",
            "DEBUG"
          ],
          "type": "string"
        },
        "ControlErrorCode": {
          "enum": [
            "invalid_config",
            "request_rejected",
            "unauthorized",
            "permission_denied",
            "cluster_not_allowed",
            "operation_not_allowed",
            "mutation_disabled",
            "operation_unavailable",
            "rate_limited",
            "confirmation_required",
            "invalid_argument",
            "audit_unavailable",
            "precondition_conflict",
            "partial_apply",
            "verification_failed",
            "timeout",
            "cancelled",
            "execution_failed",
            "shutdown_failed"
          ],
          "type": "string"
        },
        "FailureCode": {
          "enum": [
            "conflict",
            "invalid_data",
            "unavailable",
            "persistence_failed",
            "verification_failed",
            "order_reconciliation_failed"
          ],
          "type": "string"
        },
        "MutationMode": {
          "enum": [
            "dry_run",
            "execute"
          ],
          "type": "string"
        },
        "MutationResultSchemaVersion": {
          "const": "rocketmq-mcp-mutation.v1",
          "type": "string"
        },
        "MutationStatus": {
          "enum": [
            "planned",
            "applied",
            "partial",
            "conflict",
            "failed"
          ],
          "type": "string"
        },
        "OperationHolder": {
          "description": "Which operation holds a target, told without its identifier.\n\nThe identifier of an operation that another call started is that caller's text, so a response never repeats it.",
          "oneOf": [
            {
              "const": "none",
              "description": "No operation holds the target.",
              "type": "string"
            },
            {
              "const": "this_operation",
              "description": "The operation that this call names by its `operation_id`.",
              "type": "string"
            },
            {
              "const": "other_operation",
              "description": "An operation with another identifier.",
              "type": "string"
            }
          ]
        },
        "VerificationState": {
          "enum": [
            "not_performed",
            "verified",
            "failed"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/BrokerLogFilterState"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "additionalProperties": {
            "$ref": "#/$defs/BrokerLogFilterState"
          },
          "description": "State before the call, by Broker name; empty when the Broker could not be read.",
          "type": "object"
        },
        "cluster": {
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation_id": {
          "description": "Identifies this call in the durable audit log. Pass it to rocketmq_get_mutation_result to read how the call ended.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/MutationMode"
        },
        "operation": {
          "$ref": "#/$defs/BrokerLogFilterOperation"
        },
        "requested": {
          "$ref": "#/$defs/BrokerLogFilterRequested"
        },
        "schema_version": {
          "$ref": "#/$defs/MutationResultSchemaVersion"
        },
        "status": {
          "$ref": "#/$defs/MutationStatus"
        },
        "target": {
          "$ref": "#/$defs/BrokerLogFilterResource"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/BrokerLogFilterTarget"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "cluster",
        "mode",
        "status",
        "error_code",
        "target",
        "before",
        "requested",
        "after",
        "targets",
        "warnings",
        "invocation_id"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Restore RocketMQ Broker log level",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "rocketmq_get_mutation_result",
    "title": "Get RocketMQ mutation result",
    "description": "Reads how one of your own mutation calls on a cluster ended: finished with its status, still in progress, interrupted by a server restart, or not found. Use it when a mutation response was lost or timed out, selecting the call by the invocation_id of a response or by the request_key you sent. It changes nothing and never returns who made a call or why.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "description": "Logical cluster name the mutation was called with, never a NameServer or Broker address. Both the caller and the server policy must allow it.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        "invocation_id": {
          "default": null,
          "description": "The `invocation_id` of the mutation response. Give it, `request_key`, or both; with both, the invocation must also have carried that key.",
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "request_key": {
          "default": null,
          "description": "The `request_key` the mutation was called with: 8 to 64 letters, digits and `._:-`. It selects the newest of your calls that carried it, which is how to find a call whose response never arrived.",
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[a-zA-Z0-9._:-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "description": "Version of this argument schema. Always `rocketmq-mcp-control.arguments.v1`.",
          "pattern": "^rocketmq-mcp-control\\.arguments\\.v1$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "cluster"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ControlErrorCode": {
          "enum": [
            "invalid_config",
            "request_rejected",
            "unauthorized",
            "permission_denied",
            "cluster_not_allowed",
            "operation_not_allowed",
            "mutation_disabled",
            "operation_unavailable",
            "rate_limited",
            "confirmation_required",
            "invalid_argument",
            "audit_unavailable",
            "precondition_conflict",
            "partial_apply",
            "verification_failed",
            "timeout",
            "cancelled",
            "execution_failed",
            "shutdown_failed"
          ],
          "type": "string"
        },
        "ControlOperation": {
          "enum": [
            "topic_upsert",
            "consumer_group_upsert",
            "consumer_offset_reset",
            "broker_config_patch",
            "consumer_request_mode",
            "proxy_drain_begin",
            "proxy_drain_cancel",
            "broker_log_filter_set",
            "broker_log_filter_restore"
          ],
          "type": "string"
        },
        "MutationLookupSchemaVersion": {
          "const": "rocketmq-mcp-mutation-result.v1",
          "type": "string"
        },
        "MutationMode": {
          "enum": [
            "dry_run",
            "execute"
          ],
          "type": "string"
        },
        "MutationResultCounts": {
          "additionalProperties": false,
          "description": "How many targets of the mutation ended in each state.",
          "properties": {
            "applied": {
              "description": "Written and changed.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "conflict": {
              "description": "Refused because the state read before the change had changed.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "failed": {
              "description": "Failed for any other reason, including an unverified write.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "unchanged": {
              "description": "Left as they were: already in the requested state, or only planned by a dry run.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "applied",
            "unchanged",
            "conflict",
            "failed"
          ],
          "type": "object"
        },
        "MutationResultState": {
          "description": "What the server knows about the selected invocation.",
          "oneOf": [
            {
              "const": "finished",
              "description": "The mutation ended; `status` says how.",
              "type": "string"
            },
            {
              "const": "in_progress",
              "description": "The mutation is still running. Ask again later.",
              "type": "string"
            },
            {
              "const": "interrupted",
              "description": "The server stopped while the mutation was running, so its outcome was never recorded. The cluster may or may not have changed: read its current state before repeating the call.",
              "type": "string"
            },
            {
              "const": "not_found",
              "description": "None of your recent calls on this cluster matches. The call may never have started, or it is older than what the server remembers.",
              "type": "string"
            }
          ]
        },
        "MutationResultTarget": {
          "additionalProperties": false,
          "description": "The logical object of the mutation: names only, never addresses.",
          "properties": {
            "broker": {
              "description": "The one Broker of a Broker configuration patch or of a temporary log filter.",
              "type": [
                "string",
                "null"
              ]
            },
            "broker_count": {
              "description": "How many Brokers a Topic or Consumer Group upsert selected.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "broker_names": {
              "description": "Their sorted names, when the list is short enough to be kept.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "consumer_group": {
              "type": [
                "string",
                "null"
              ]
            },
            "proxy": {
              "description": "The Proxy of a drain, by its configured alias.",
              "type": [
                "string",
                "null"
              ]
            },
            "topic": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "MutationStatus": {
          "enum": [
            "planned",
            "applied",
            "partial",
            "conflict",
            "failed"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether at least one target was written; null when the mutation ended without reporting it, for example after a timeout. Null does not mean that nothing changed."
        },
        "cluster": {
          "type": "string"
        },
        "duration_millis": {
          "anyOf": [
            {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "How long it ran, in milliseconds; null unless `state` is `finished`."
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "The error code of a mutation that did not end as planned or applied; null otherwise."
        },
        "invocation_id": {
          "anyOf": [
            {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The invocation this answer is about; null when `state` is `not_found`."
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether it was a dry run or an execution; null when `state` is `not_found`."
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlOperation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which mutation it was; null when `state` is `not_found`."
        },
        "schema_version": {
          "$ref": "#/$defs/MutationLookupSchemaVersion"
        },
        "state": {
          "$ref": "#/$defs/MutationResultState"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "How it ended; null unless `state` is `finished`."
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationResultTarget"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it was aimed at; null when `state` is `not_found` or the object was not recorded."
        },
        "target_results": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationResultCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-target outcome counts; null when the mutation ended without reporting them."
        }
      },
      "required": [
        "schema_version",
        "cluster",
        "state",
        "invocation_id",
        "operation",
        "mode",
        "target",
        "status",
        "error_code",
        "duration_millis",
        "changed",
        "target_results"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Get RocketMQ mutation result",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
