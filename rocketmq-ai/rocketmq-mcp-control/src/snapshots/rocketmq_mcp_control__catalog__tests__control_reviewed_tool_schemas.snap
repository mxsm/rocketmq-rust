            "held_by",
            "admission_open",
            "routing_open",
            "readiness_published",
            "zero_pending",
            "pending"
          ],
          "type": "object"
        },
        "ProxyDrainTarget": {
          "additionalProperties": false,
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProxyDrainState"
                },
                {
                  "type": "null"
                }
              ],
              "description": "State read after an execution; null for a dry run and when the Proxy could not be read again."
            },
            "applied": {
              "description": "Whether the Proxy acknowledged the action or already was in the requested state.",
              "type": "boolean"
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProxyDrainState"
                },
                {
                  "type": "null"
                }
              ],
              "description": "State read before the call changed anything; null when the Proxy could not be read."
            },
            "changed": {
              "description": "For a dry run, whether executing would change the Proxy; otherwise whether it changed.",
              "type": "boolean"
            },
            "failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FailureCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proxy_name": {
              "type": "string"
            },
            "requested": {
              "$ref": "#/$defs/ProxyDrainRequested"
            },
            "retryable": {
              "type": "boolean"
            },
            "verification": {
              "$ref": "#/$defs/VerificationState"
            }
          },
          "required": [
            "proxy_name",
            "before",
            "requested",
            "after",
            "applied",
            "changed",
            "verification",
            "failure",
            "retryable"
          ],
          "type": "object"
        },
        "VerificationState": {
          "enum": [
            "not_performed",
            "verified",
            "failed"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
