              "$ref": "#/$defs/ConsumerRequestMode"
            },
            "pop_share_queue_num": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "mode",
            "pop_share_queue_num"
          ],
          "type": "object"
        },
        "VerificationState": {
