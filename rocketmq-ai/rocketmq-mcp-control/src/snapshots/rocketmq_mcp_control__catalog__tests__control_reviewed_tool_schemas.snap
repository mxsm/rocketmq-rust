            },
            {
              "properties": {
                "kind": {
                  "const": "present",
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/ConsumerGroupReplacement"
                },
                "version": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "version",
                "value"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "after": {
          "additionalProperties": {
            "$ref": "#/$defs/VisibleState"
