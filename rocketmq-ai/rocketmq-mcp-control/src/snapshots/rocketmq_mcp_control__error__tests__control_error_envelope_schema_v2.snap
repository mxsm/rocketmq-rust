---
source: src/error.rs
expression: "schemars::schema_for!(ControlErrorEnvelope)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlErrorEnvelope",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ControlErrorCode"
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "schema_version": {
      "$ref": "#/$defs/ControlErrorSchemaVersion"
    },
    "violations": {
      "description": "Arguments of an `invalid_argument` call that break the Tool input schema; omitted when none is located.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArgumentViolation"
      },
      "maxItems": 3
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "message",
    "retryable"
  ],
  "$defs": {
    "ArgumentViolation": {
      "description": "One argument that broke the Tool input schema: where it is and which kind of rule it broke.\n\nIt never repeats a value that was sent, and its path uses only names the input schema declares.",
      "type": "object",
      "properties": {
        "constraint": {
          "$ref": "#/$defs/ViolationConstraint"
        },
        "path": {
          "description": "JSON Pointer to the argument; `*` stands for a property the input schema does not declare.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "constraint"
      ]
    },
    "ControlErrorCode": {
      "type": "string",
      "enum": [
        "invalid_config",
        "request_rejected",
        "unauthorized",
        "permission_denied",
        "cluster_not_allowed",
        "operation_not_allowed",
        "mutation_disabled",
        "operation_unavailable",
        "rate_limited",
        "confirmation_required",
        "invalid_argument",
        "audit_unavailable",
        "precondition_conflict",
        "partial_apply",
        "verification_failed",
        "timeout",
        "cancelled",
        "execution_failed",
        "shutdown_failed"
      ]
    },
    "ControlErrorSchemaVersion": {
      "type": "string",
      "const": "rocketmq-mcp-control.error.v2"
    },
    "ViolationConstraint": {
      "description": "The closed set of rule kinds that an argument violation reports.",
      "type": "string",
      "enum": [
        "required",
        "type",
        "min_length",
        "max_length",
        "minimum",
        "maximum",
        "enum",
        "pattern",
        "additional_property",
        "other"
      ]
    }
  }
}
