    { "name": "fifo", "properties": { "__SHARDINGKEY": "order-a" }, "expected": "FIFO" },
    { "name": "delay", "properties": { "TIMER_DELIVER_MS": "1710000000000" }, "expected": "DELAY" },
    { "name": "transaction", "properties": { "TRAN_MSG": "true" }, "expected": "TRANSACTION" },
    { "name": "priority", "properties": { "_SYS_MSG_PRIORITY_": "3" }, "expected": "PRIORITY" },
    { "name": "lite", "properties": { "__LITE_TOPIC": "child" }, "expected": "LITE" },
    {
      "name": "transaction-precedes-all",
      "properties": {
        "TRAN_MSG": "true",
        "TIMER_DELIVER_MS": "1710000000000",
        "__SHARDINGKEY": "order-a",
        "_SYS_MSG_PRIORITY_": "3",
        "__LITE_TOPIC": "child"
      },
      "expected": "TRANSACTION"
    },
    {
      "name": "priority-precedes-lite",
      "properties": { "_SYS_MSG_PRIORITY_": "3", "__LITE_TOPIC": "child" },
      "expected": "PRIORITY"
    }
  ],
  "validationCases": [
    { "expected": "NORMAL", "actual": "NORMAL", "accepted": true },
    { "expected": "FIFO", "actual": "FIFO", "accepted": true },
    { "expected": "DELAY", "actual": "DELAY", "accepted": true },
    { "expected": "TRANSACTION", "actual": "TRANSACTION", "accepted": true },
