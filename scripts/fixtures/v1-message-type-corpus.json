    { "expected": "MIXED", "actual": "NORMAL", "accepted": true },
    { "expected": "MIXED", "actual": "FIFO", "accepted": true },
    { "expected": "MIXED", "actual": "DELAY", "accepted": true },
    { "expected": "MIXED", "actual": "TRANSACTION", "accepted": true },
    { "expected": "MIXED", "actual": "PRIORITY", "accepted": true },
    { "expected": "MIXED", "actual": "LITE", "accepted": true },
    { "expected": "MIXED", "actual": "UNSPECIFIED", "accepted": false }
