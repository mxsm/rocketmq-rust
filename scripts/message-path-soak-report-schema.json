{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketmqrust.com/schemas/message-path-soak-report-v1.json",
  "title": "RocketMQ Rust message-path soak report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "monotonic_growth_detected",
    "profile",
    "started_at",
    "finished_at",
    "duration_seconds",
    "release_identity",
    "sampling",
    "pods",
    "series",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "rocketmq_message_path_soak_report" },
    "status": { "enum": ["pass", "fail"] },
    "monotonic_growth_detected": { "type": "boolean" },
    "profile": { "enum": ["smoke", "full"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "duration_seconds": { "type": "integer", "minimum": 60 },
    "release_identity": {
      "type": "object",
      "required": [
        "commit",
        "deployment_digest",
        "target_id",
        "cluster_uid",
        "effective_config_sha256",
        "durability_contract"
      ]
    },
    "sampling": {
      "type": "object",
      "required": ["interval_seconds", "expected", "observed", "coverage_percent", "max_gap_seconds"]
    },
    "pods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "uid", "restarts", "oom_killed"]
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "scope",
          "kind",
          "status",
          "first_window_median",
          "last_window_median",
          "p95",
          "p99",
          "max",
          "theil_sen_slope_per_hour",
          "kendall_tau",
          "raw_artifact_sha256"
        ]
      }
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
