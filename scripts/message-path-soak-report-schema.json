{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketmq.apache.org/schemas/message-path-soak-report-v1.json",
  "title": "RocketMQ Rust message-path soak report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "monotonic_growth_detected",
    "duration_seconds",
    "release_identity",
    "sampling",
    "pods",
    "series",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_kind": { "const": "rocketmq_message_path_soak_report" },
    "status": { "enum": ["pass", "fail"] },
    "monotonic_growth_detected": { "type": "boolean" },
    "duration_seconds": { "type": "integer", "minimum": 21600 },
    "release_identity": {
      "type": "object",
      "required": [
        "commit",
        "deployment_digest",
        "target_id",
        "cluster_uid",
        "effective_config_sha256",
        "durability_contract"
      ]
    },
    "sampling": {
      "type": "object",
      "required": ["interval_seconds", "expected", "observed", "coverage_percent", "max_gap_seconds"]
    },
    "pods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "uid", "restarts", "oom_killed"]
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "scope", "status", "raw_artifact_sha256"]
      }
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
