{
  "schema_version": 2,
  "milestone": "P0",
  "design_source": "rocketmq-doc/en/architecture-release-governance.md#release-topology",
  "release_topology": {
    "publish_order": [
      "rocketmq-error",
      "rocketmq-macros",
      "rocketmq-runtime",
      "rocketmq-model",
      "rocketmq-dashboard-common",
      "rocketmq-observability",
      "rocketmq-protocol",
      "rocketmq-security-api",
      "rocketmq-filter",
      "rocketmq-transport",
      "rocketmq-auth",
      "rocketmq-proxy-core",
      "rocketmq-client-rust",
      "rocketmq-store-api",
      "rocketmq-controller",
      "rocketmq-admin-core",
      "rocketmq-namesrv",
      "rocketmq-proxy-cluster",
      "rocketmq-store-local",
      "rocketmq-tieredstore",
      "rocketmq-admin-cli",
      "rocketmq-admin-tui",
      "rocketmq-mcp",
      "rocketmq-store-rocksdb",
      "rocketmq-store",
      "rocketmq-broker",
      "rocketmq-store-inspect",
      "rocketmq-proxy-local",
      "rocketmq-proxy"
    ],
    "rule": "Publish each package only after every current transition dependency is available at the same release version."
  },
  "transition_debt": {
    "source": "scripts/architecture-dependency-policy.json#target_debt",
    "required_mode": "transition",
    "strict_target_required_when_empty": true
  },
  "compatibility_windows": {
    "source": "scripts/architecture-dependency-baseline.json#compatibility_manifest_exceptions",
    "preserved_edges": [
      {
        "caller": "rocketmq-broker",
        "target": "rocketmq-store",
        "kind": "normal",
        "path": "rocketmq-broker/Cargo.toml",
        "alias": "rocketmq_store",
        "remove_by": "2.0.0"
      },
      {
        "caller": "rocketmq-store-inspect",
        "target": "rocketmq-store",
        "kind": "normal",
        "path": "rocketmq-tools/rocketmq-store-inspect/Cargo.toml",
        "alias": "rocketmq_store",
        "remove_by": "2.0.0"
      }
    ]
  }
}
