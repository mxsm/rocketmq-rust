{
  "schema_version": 1,
  "roots": {
    "workspace_manifest": "Cargo.toml",
    "source_root": ".",
    "standalone_manifests": [
      "rocketmq-example/Cargo.toml",
      "rocketmq-ai/rocketmq-mcp/Cargo.toml",
      "rocketmq-dashboard/rocketmq-dashboard-gpui/Cargo.toml",
      "rocketmq-dashboard/rocketmq-dashboard-tauri/src-tauri/Cargo.toml",
      "rocketmq-dashboard/rocketmq-dashboard-web/backend/Cargo.toml",
      "fuzz/Cargo.toml"
    ]
  },
  "package_rules": [
    {
      "id": "protocol-no-transport",
      "callers": [
        "rocketmq-protocol"
      ],
      "forbidden_targets": [
        "rocketmq-transport"
      ]
    },
    {
      "id": "store-api-no-backend",
      "callers": [
        "rocketmq-store-api"
      ],
      "forbidden_targets": [
        "rocketmq-store",
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore"
      ]
    },
    {
      "id": "store-api-runtime-neutral",
      "callers": [
        "rocketmq-store-api"
      ],
      "forbidden_targets": [
        "rocketmq-runtime",
        "rocketmq-remoting",
        "rocketmq-observability",
        "rocketmq-broker",
        "tokio",
        "tokio-util"
      ]
    },
    {
      "id": "security-api-contract-only",
      "callers": [
        "rocketmq-security-api"
      ],
      "forbidden_targets": [
        "rocketmq-protocol",
        "rocketmq-transport",
        "rocketmq-auth",
        "rocketmq-remoting",
        "rocketmq-common",
        "rocketmq-store",
        "rocketmq-broker",
        "rocketmq-proxy"
      ]
    },
    {
      "id": "foundation-runtime-error-leaf",
      "callers": [
        "rocketmq-runtime",
        "rocketmq-error"
      ],
      "forbidden_targets": [
        "rocketmq-model",
        "rocketmq-protocol",
        "rocketmq-security-api",
        "rocketmq-store-api",
        "rocketmq-transport",
        "rocketmq-auth",
        "rocketmq-observability",
        "rocketmq-common",
        "rocketmq-remoting",
        "rocketmq-store",
        "rocketmq-rust",
        "rocketmq-broker",
        "rocketmq-namesrv",
        "rocketmq-controller",
        "rocketmq-client-rust",
        "rocketmq-proxy"
      ]
    },
    {
      "id": "transport-no-high-level",
      "callers": [
        "rocketmq-transport"
      ],
      "forbidden_targets": [
        "rocketmq-auth",
        "rocketmq-client-rust",
        "rocketmq-broker",
        "rocketmq-namesrv",
        "rocketmq-controller",
        "rocketmq-store",
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore",
        "rocketmq-proxy",
        "rocketmq-proxy-core",
        "rocketmq-proxy-cluster",
        "rocketmq-proxy-local"
      ]
    },
    {
      "id": "store-backend-direction",
      "callers": [
        "rocketmq-store-local"
      ],
      "forbidden_targets": [
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore",
        "rocketmq-store",
        "rocketmq-broker",
        "rocketmq-remoting"
      ]
    },
    {
      "id": "rocksdb-backend-direction",
      "callers": [
        "rocketmq-store-rocksdb"
      ],
      "forbidden_targets": [
        "rocketmq-tieredstore",
        "rocketmq-store",
        "rocketmq-broker"
      ]
    },
    {
      "id": "tiered-backend-direction",
      "callers": [
        "rocketmq-tieredstore"
      ],
      "forbidden_targets": [
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-store",
        "rocketmq-broker"
      ]
    },
    {
      "id": "store-facade-no-high-level-services",
      "callers": [
        "rocketmq-store"
      ],
      "forbidden_targets": [
        "rocketmq-client-rust",
        "rocketmq-broker",
        "rocketmq-namesrv",
        "rocketmq-controller",
        "rocketmq-proxy"
      ]
    },
    {
      "id": "proxy-local-no-client",
      "callers": [
        "rocketmq-proxy-local"
      ],
      "forbidden_targets": [
        "rocketmq-client-rust"
      ]
    },
    {
      "id": "proxy-core-no-implementations",
      "callers": [
        "rocketmq-proxy-core"
      ],
      "forbidden_targets": [
        "rocketmq-client-rust",
        "rocketmq-broker",
        "rocketmq-store",
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore"
      ]
    },
    {
      "id": "foundation-no-facade",
      "callers": [
        "rocketmq-model",
        "rocketmq-protocol",
        "rocketmq-security-api",
        "rocketmq-store-api"
      ],
      "forbidden_targets": [
        "rocketmq-rust",
        "rocketmq-common",
        "rocketmq-remoting",
        "rocketmq-store",
        "rocketmq-proxy"
      ]
    },
    {
      "id": "foundation-no-runtime-framework",
      "callers": [
        "rocketmq-model",
        "rocketmq-protocol",
        "rocketmq-security-api",
        "rocketmq-store-api"
      ],
      "forbidden_targets": [
        "tokio",
        "tokio-util",
        "tonic",
        "rustls",
        "tokio-rustls",
        "ring",
        "aws-lc-rs"
      ]
    },
    {
      "id": "new-boundaries-no-legacy-runtime",
      "callers": [
        "rocketmq-model",
        "rocketmq-protocol",
        "rocketmq-transport",
        "rocketmq-security-api",
        "rocketmq-store-api",
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-proxy-core",
        "rocketmq-proxy-cluster",
        "rocketmq-proxy-local"
      ],
      "forbidden_targets": [
        "rocketmq-rust"
      ]
    }
  ],
  "closure_rules": [
    {
      "callers": [
        "rocketmq-protocol"
      ],
      "forbidden_targets": [
        "rocketmq-common",
        "rocketmq-remoting",
        "rocketmq-runtime",
        "rocketmq-rust",
        "rocketmq-auth",
        "rocketmq-client-rust",
        "rocketmq-broker",
        "rocketmq-namesrv",
        "rocketmq-controller",
        "rocketmq-store",
        "rocketmq-proxy"
      ]
    },
    {
      "callers": [
        "rocketmq-transport"
      ],
      "forbidden_targets": [
        "rocketmq-common",
        "rocketmq-remoting",
        "rocketmq-store",
        "rocketmq-rust",
        "rocketmq-auth",
        "rocketmq-client-rust",
        "rocketmq-broker",
        "rocketmq-proxy"
      ]
    },
    {
      "callers": [
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore"
      ],
      "forbidden_targets": [
        "rocketmq-common",
        "rocketmq-remoting",
        "rocketmq-store",
        "rocketmq-rust",
        "rocketmq-broker"
      ]
    },
    {
      "callers": [
        "rocketmq-broker",
        "rocketmq-namesrv",
        "rocketmq-proxy-core",
        "rocketmq-proxy-local"
      ],
      "forbidden_targets": [
        "rocketmq-client-rust"
      ]
    },
    {
      "callers": [
        "rocketmq-proxy-cluster"
      ],
      "forbidden_targets": [
        "rocketmq-broker",
        "rocketmq-store",
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore"
      ]
    }
  ],
  "facade_rules": [
    {
      "facade": "rocketmq-store",
      "canonical_packages": [
        "rocketmq-store-api",
        "rocketmq-store-local",
        "rocketmq-store-rocksdb",
        "rocketmq-tieredstore"
      ]
    },
    {
      "facade": "rocketmq-proxy",
      "canonical_packages": [
        "rocketmq-proxy-core",
        "rocketmq-proxy-cluster",
        "rocketmq-proxy-local"
      ]
    }
  ]
}
