# MySQL is suitable for a multi-node dashboard deployment. The complete
# TLS-verified URL is read from /run/secrets/dashboard_database_url, never from
# this environment file. It must use ssl-mode=verify_identity and reference
# /run/secrets/mysql-ca.pem.
DASHBOARD_WEB_HOST=0.0.0.0
DASHBOARD_WEB_PORT=8082
NAMESRV_ADDR=namesrv.example.internal:9876
DASHBOARD_WEB_STORAGE_BACKEND=mysql
DASHBOARD_WEB_DATABASE_URL_FILE=/run/secrets/dashboard_database_url
DASHBOARD_WEB_DB_MIN_CONNECTIONS=1
DASHBOARD_WEB_DB_MAX_CONNECTIONS=10
DASHBOARD_WEB_DB_CONNECT_TIMEOUT_MS=5000
DASHBOARD_WEB_DB_ACQUIRE_TIMEOUT_MS=5000
DASHBOARD_WEB_DB_IDLE_TIMEOUT_SECS=300
DASHBOARD_WEB_DB_MAX_LIFETIME_SECS=1800
DASHBOARD_WEB_LOGIN_REQUIRED=true
