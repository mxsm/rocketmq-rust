# File storage is a single-node deployment. Do not run more than one dashboard
# process against this directory.
DASHBOARD_WEB_HOST=0.0.0.0
DASHBOARD_WEB_PORT=8082
NAMESRV_ADDR=namesrv.example.internal:9876
DASHBOARD_WEB_STORAGE_BACKEND=file
DASHBOARD_WEB_STORAGE_PATH=/var/lib/rocketmq-dashboard/file
DASHBOARD_WEB_LOGIN_REQUIRED=true
DASHBOARD_WEB_HISTORY_INTERVAL_SECS=60
DASHBOARD_WEB_HISTORY_RETENTION_DAYS=30
DASHBOARD_WEB_HISTORY_RETENTION_BATCH_SIZE=500
