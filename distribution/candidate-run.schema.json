{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketmq-rust.local/schemas/candidate-run.schema.json",
  "title": "RocketMQ Rust local release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "version",
    "run_id",
    "attempt",
    "ordinal",
    "candidate_root",
    "series_manifest",
    "series_id",
    "series_generation",
    "parent_manifest",
    "state",
    "sealed",
    "outcome",
    "known_issues",
    "generation",
    "route_denominator"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_kind": { "enum": ["rc", "final"] },
    "version": { "type": "string", "pattern": "^1\\.0\\.0(?:-rc\\.[1-9][0-9]*)?$" },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "ordinal": { "type": "integer", "minimum": 1 },
    "candidate_root": { "type": "string", "minLength": 1 },
    "series_manifest": { "type": "string", "minLength": 1 },
    "series_id": { "type": "string", "minLength": 1 },
    "series_generation": { "type": "integer", "minimum": 1 },
    "parent_manifest": { "type": ["string", "null"] },
    "state": { "enum": ["development", "staged-rc", "rc-candidate-ready", "ga-candidate-ready", "publication-ready", "rejected"] },
    "sealed": { "type": "boolean" },
    "outcome": { "enum": ["success", "rejected", null], "type": ["string", "null"] },
    "rejection_reason": { "type": ["string", "null"] },
    "known_issues": { "type": "array", "items": { "type": "object" } },
    "generation": { "type": "integer", "minimum": 0 },
    "build_source_bundle": { "type": ["string", "null"] },
    "source_snapshot": { "type": ["string", "null"] },
    "artifact_index": { "type": ["string", "null"] },
    "evidence_index": { "type": ["string", "null"] },
    "event_index": { "type": ["string", "null"] },
    "execution_context_index": { "type": ["string", "null"] },
    "route_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "audit_points"],
      "properties": {
        "schema_version": { "const": 1 },
        "audit_points": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "creation_operation_id": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
