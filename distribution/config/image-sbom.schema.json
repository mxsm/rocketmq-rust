{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketmq.apache.org/schemas/local-image-sbom-v1.json",
  "title": "RocketMQ Rust local image CycloneDX SBOM subset",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "bomFormat",
    "specVersion",
    "version",
    "metadata",
    "components"
  ],
  "properties": {
    "bomFormat": {
      "const": "CycloneDX"
    },
    "specVersion": {
      "const": "1.6"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "timestamp",
        "component",
        "properties"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "component": {
          "type": "object",
          "required": [
            "type",
            "name",
            "version",
            "hashes"
          ]
        },
        "properties": {
          "type": "array",
          "minItems": 3
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "version"
        ]
      }
    }
  }
}
