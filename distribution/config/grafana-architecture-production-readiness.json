  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Five-minute delivered/accepted message ratio. The production objective is at least 0.999.",
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(rocketmq_messages_out_total[$__rate_interval])) / clamp_min(sum(rate(rocketmq_messages_in_total[$__rate_interval])), 0.000001)",
          "legendFormat": "delivery ratio",
          "refId": "A"
        }
      ],
      "title": "Message Delivery Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "Five-minute p99 send-message latency. The production objective is at most 1000 ms.",
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(rocketmq_send_message_latency_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "title": "Send Message P99 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Maximum consumer lag. The production objective is at most 10000 messages.",
      "id": 3,
      "targets": [
        {
          "expr": "max(rocketmq_consumer_lag_messages)",
          "legendFormat": "max lag",
          "refId": "A"
        }
      ],
      "title": "Consumer Lag",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 67108864
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "description": "Store flush and dispatch backlog. Flush-behind must remain at or below 64 MiB.",
      "id": 4,
      "targets": [
        {
          "expr": "max(rocketmq_storage_flush_behind_bytes)",
          "legendFormat": "flush",
          "refId": "A"
        },
        {
          "expr": "max(rocketmq_storage_dispatch_behind_bytes)",
          "legendFormat": "dispatch",
          "refId": "B"
        }
      ],
      "title": "Store Flush and Dispatch Lag",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 67108864
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "description": "Maximum Broker HA replication lag. The production objective is at most 64 MiB.",
      "id": 5,
      "targets": [
        {
          "expr": "max(rocketmq_store_ha_replication_lag_bytes)",
          "legendFormat": "replication lag",
          "refId": "A"
        }
      ],
      "title": "HA Replication Lag",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Exactly one low-cardinality release identity should be active for each service instance.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "expr": "max by (service, release_commit, release_nonce) (rocketmq_release_info)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{service}} {{release_commit}} {{release_nonce}}",
          "refId": "A"
        }
      ],
      "title": "Release Identity Registration",
      "type": "table"
    },
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "content": "The release evidence must include the `collector_outage` scenario with a successful message round trip below 30 seconds. Admission is non-blocking and bounded to 2048 records, 8 MiB total, and 64 KiB per record; drops are reported through `rocketmq.exporter.drop`. A dashboard cannot replace the signed fault artifact.",
        "mode": "markdown"
      },
      "title": "Collector Outage Budget",
      "type": "text"
    },
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "options": {
        "content": "The release evidence must report zero `FailedPreStopHook` events and prove baseline image/chart restoration without deleting PVCs or WAL.",
        "mode": "markdown"
      },
      "title": "Drain and Rollback Health",
      "type": "text"
    }
