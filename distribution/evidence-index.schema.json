{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketmq-rust.local/schemas/evidence-index.schema.json",
  "title": "RocketMQ Rust candidate evidence index",
  "type": "object",
  "required": ["schema_version", "candidate_id", "version", "run_id", "attempt", "status", "result_ids"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "const": "passed" },
    "result_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
