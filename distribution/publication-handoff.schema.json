{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketmq-rust.local/schemas/publication-handoff.schema.json",
  "title": "RocketMQ Rust local publication handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "version",
    "run_id",
    "attempt",
    "candidate_state",
    "candidate_generation",
    "series_id",
    "series_generation",
    "distribution_identity",
    "distribution_name",
    "release_approver",
    "official_apache_release",
    "remote_publication",
    "future_publication",
    "targets",
    "evidence_result_ids",
    "excluded_capabilities",
    "controller_boundary",
    "java_data_migration_profile",
    "deferred_validation",
    "known_issue_ids",
    "source_bindings",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "candidate_state": { "const": "ga-candidate-ready" },
    "candidate_generation": { "type": "integer", "minimum": 0 },
    "series_id": { "type": "string", "minLength": 1 },
    "series_generation": { "type": "integer", "minimum": 1 },
    "distribution_identity": { "const": "unofficial-community" },
    "distribution_name": { "const": "RocketMQ Rust Community Distribution" },
    "release_approver": { "const": "mxsm" },
    "official_apache_release": { "const": false },
    "remote_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "publishing_credentials_provided", "workflow_dispatches"],
      "properties": {
        "status": { "const": "not-executed" },
        "publishing_credentials_provided": { "const": false },
        "workflow_dispatches": { "type": "array", "maxItems": 0 }
      }
    },
    "future_publication": { "type": "object" },
    "targets": { "type": "array", "minItems": 3, "maxItems": 3 },
    "evidence_result_ids": { "type": "array", "items": { "type": "string" } },
    "excluded_capabilities": { "type": "array" },
    "controller_boundary": { "type": "string" },
    "java_data_migration_profile": { "type": "string" },
    "deferred_validation": { "type": "array", "items": { "type": "string" } },
    "known_issue_ids": { "type": "array" },
    "source_bindings": { "type": "array" },
    "files": { "type": "array" }
  }
}
