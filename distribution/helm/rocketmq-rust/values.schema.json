{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mxsm/rocketmq-rust/distribution/helm/rocketmq-rust/values.schema.json",
  "title": "RocketMQ Rust deployment values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deploymentProfile",
    "global",
    "releaseIdentity",
    "maintenance",
    "metrics",
    "namespace",
    "networkPolicy",
    "services"
  ],
  "properties": {
    "deploymentProfile": {
      "type": "string",
      "enum": [
        "dev-single",
        "production-controller-ha"
      ]
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imagePullSecrets",
        "otelEndpoint",
        "secretRefs",
        "runtimeDiagnostics",
        "podSecurity"
      ],
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "otelEndpoint": {
          "type": "string",
          "pattern": "^https?://[^\\s]+:4317$"
        },
        "secretRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "secretProviderClassName"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretProviderClassName": {
              "type": "string"
            }
          },
          "oneOf": [
            {
              "properties": {
                "existingSecret": {
                  "minLength": 1
                },
                "secretProviderClassName": {
                  "maxLength": 0
                }
              }
            },
            {
              "properties": {
                "existingSecret": {
                  "maxLength": 0
                },
                "secretProviderClassName": {
                  "minLength": 1
                }
              }
            }
          ]
        },
        "runtimeDiagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "bindAddress",
            "port",
            "tokenFile",
            "sampleIntervalSeconds",
            "allowInsecureHttp"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "bindAddress": {
              "type": "string",
              "pattern": "^([^\\s:]+|\\[[0-9A-Fa-f:]+\\]):[0-9]{1,5}$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tokenFile": {
              "type": "string",
              "pattern": "^/[^\\s]+$"
            },
            "sampleIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "allowInsecureHttp": {
              "type": "boolean"
            }
          }
        },
        "podSecurity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runAsUser",
            "runAsGroup",
            "fsGroup"
          ],
          "properties": {
            "runAsUser": {
              "type": "integer",
              "minimum": 1
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 1
            },
            "fsGroup": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "nonce",
        "configDigest",
        "secretVersion",
        "storageGeneration"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "description": "Exact non-zero lowercase 40-character source revision embedded in every service image.",
          "pattern": "^[0-9a-f]{40}$",
          "not": {
            "const": "0000000000000000000000000000000000000000"
          }
        },
        "nonce": {
          "type": "string",
          "description": "Required stable identifier for this rollout.",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "configDigest": {
          "type": "string",
          "description": "SHA-256 digest of the complete non-sensitive configuration bundle.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "secretVersion": {
          "type": "string",
          "description": "Opaque version of the referenced Secret; this field must never contain Secret material.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "storageGeneration": {
          "type": "integer",
          "description": "Monotonically increasing generation shared by the persisted release state.",
          "minimum": 1
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "configMapName",
        "policyKey",
        "mountPath",
        "version",
        "sha256"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMapName": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "policyKey": {
          "type": "string",
          "const": "maintenance-policy.json"
        },
        "mountPath": {
          "type": "string",
          "const": "/etc/rocketmq/auth/maintenance-policy.json"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "port",
        "path",
        "service",
        "serviceMonitor",
        "networkPolicy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^/[A-Za-z0-9._/-]*$"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "interval",
            "scrapeTimeout",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "description": "Positive whole seconds or minutes with at most nine digits, for example 30s or 2m.",
              "maxLength": 10,
              "pattern": "^[1-9][0-9]{0,8}(?:s|m)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "description": "Positive whole seconds or minutes with at most nine digits; must not exceed interval.",
              "maxLength": 10,
              "pattern": "^[1-9][0-9]{0,8}(?:s|m)$"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "scraperNamespaceLabels",
            "scraperPodLabels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scraperNamespaceLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "scraperPodLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "clientNamespaceLabel",
        "observabilityNamespaceLabel"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientNamespaceLabel": {
          "type": "string",
          "minLength": 1
        },
        "observabilityNamespaceLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker",
        "namesrv",
        "controller",
        "proxy",
        "mcp"
      ],
      "properties": {
        "broker": {
          "$ref": "#/definitions/broker"
        },
        "namesrv": {
          "$ref": "#/definitions/namesrv"
        },
        "controller": {
          "$ref": "#/definitions/controller"
        },
        "proxy": {
          "$ref": "#/definitions/proxy"
        },
        "mcp": {
          "$ref": "#/definitions/mcp"
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s:@]+(?::[0-9]+)?(?:/[^\\s:@]+)*$"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(?:|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "tag": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "digest": {
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourcePair"
        },
        "limits": {
          "$ref": "#/definitions/resourcePair"
        }
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:m)?$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:Mi|Gi)$"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "storageClassName",
        "size"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClassName": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:Mi|Gi|Ti)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "storageClassName": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minAvailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "replicaGroupName",
        "autoCreateTopicEnable",
        "logFilterReloadEnabled",
        "image",
        "persistence",
        "pdb",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "replicaGroupName": {
          "type": "string",
          "minLength": 1
        },
        "autoCreateTopicEnable": {
          "type": "boolean"
        },
        "logFilterReloadEnabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "namesrv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "discovery",
        "image",
        "persistence",
        "pdb",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "mode"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": [
                "dns"
              ]
            }
          }
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "peerServiceClusterIPs",
        "autoInitializeCluster",
        "storageBackend",
        "image",
        "persistence",
        "pdb",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "peerServiceClusterIPs": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        },
        "autoInitializeCluster": {
          "type": "boolean"
        },
        "storageBackend": {
          "type": "string",
          "enum": [
            "Memory",
            "RocksDB"
          ]
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "innerCredentials",
        "pdb",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "innerCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "secretName",
            "secretKey"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "secretName": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "image",
        "publicBaseUrl",
        "oauth",
        "persistence",
        "pdb",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "publicBaseUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "audience",
            "jwksUrl"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^https://"
            },
            "audience": {
              "type": "string",
              "minLength": 1
            },
            "jwksUrl": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deploymentProfile": {
            "const": "production-controller-ha"
          }
        }
      },
      "then": {
        "properties": {
          "maintenance": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "services": {
            "properties": {
              "broker": {
                "properties": {
                  "replicas": {
                    "minimum": 3
                  },
                  "persistence": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  },
                  "pdb": {
                    "properties": {
                      "enabled": {
                        "const": true
                      },
                      "minAvailable": {
                        "minimum": 2
                      }
                    }
                  }
                }
              },
              "namesrv": {
                "properties": {
                  "replicas": {
                    "minimum": 3
                  },
                  "persistence": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  },
                  "pdb": {
                    "properties": {
                      "enabled": {
                        "const": true
                      },
                      "minAvailable": {
                        "minimum": 2
                      }
                    }
                  }
                }
              },
              "controller": {
                "properties": {
                  "replicas": {
                    "enum": [
                      3,
                      5,
                      7,
                      9
                    ]
                  },
                  "peerServiceClusterIPs": {
                    "minItems": 3
                  },
                  "storageBackend": {
                    "const": "RocksDB"
                  },
                  "persistence": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  },
                  "pdb": {
                    "properties": {
                      "enabled": {
                        "const": true
                      },
                      "minAvailable": {
                        "minimum": 2
                      }
                    }
                  }
                }
              },
              "proxy": {
                "properties": {
                  "replicas": {
                    "minimum": 2
                  },
                  "pdb": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deploymentProfile": {
            "const": "dev-single"
          }
        }
      },
      "then": {
        "properties": {
          "services": {
            "properties": {
              "broker": {
                "properties": {
                  "replicas": {
                    "const": 1
                  }
                }
              },
              "namesrv": {
                "properties": {
                  "replicas": {
                    "const": 1
                  }
                }
              },
              "controller": {
                "properties": {
                  "replicas": {
                    "const": 1
                  },
                  "peerServiceClusterIPs": {
                    "maxItems": 0
                  }
                }
              },
              "proxy": {
                "properties": {
                  "replicas": {
                    "const": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
