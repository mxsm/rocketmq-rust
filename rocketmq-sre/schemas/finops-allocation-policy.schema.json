{
  "$defs": {
    "FinOpsAllocationMode": {
      "description": "Allocation mode is showback unless an organization explicitly confirms\nits chargeback keys.",
      "enum": [
        "showback",
        "chargeback"
      ],
      "type": "string"
    },
    "FinOpsAllocationPolicyId": {
      "description": "Stable identifier for a showback or confirmed chargeback allocation policy.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned cost-allocation policy.",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "allocation_keys": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/FinOpsAllocationPolicyId"
    },
    "mode": {
      "$ref": "#/$defs/FinOpsAllocationMode"
    },
    "organization_confirmed": {
      "type": "boolean"
    },
    "owner": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "version": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "version",
    "mode",
    "allocation_keys",
    "organization_confirmed",
    "owner",
    "active",
    "created_at"
  ],
  "title": "FinOpsAllocationPolicy",
  "type": "object"
}
