{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "ForecastId": {
      "description": "Stable identifier for a capacity or backlog forecast.",
      "format": "uuid",
      "type": "string"
    },
    "ForecastStatus": {
      "description": "Forecast availability and degradation state.",
      "enum": [
        "ready",
        "insufficient_data",
        "stale",
        "unstable_trend",
        "unsupported"
      ],
      "type": "string"
    },
    "ResourceKind": {
      "description": "Resource classes accepted by the Phase 2 correlation engine.",
      "enum": [
        "cluster",
        "name_server",
        "controller",
        "broker",
        "proxy",
        "store",
        "topic",
        "queue",
        "consumer_group",
        "producer_group",
        "pod",
        "node",
        "persistent_volume_claim",
        "certificate",
        "runtime",
        "telemetry"
      ],
      "type": "string"
    },
    "ResourceRef": {
      "description": "Tenant-scoped resource identity used for correlation and topology lookup.",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "type": "object"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Estimated drain time for a lag, retry, DLQ, POP, or timer backlog.",
  "properties": {
    "algorithm_version": {
      "type": "string"
    },
    "arrival_rate_per_second": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "backlog_kind": {
      "type": "string"
    },
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "coverage_ratio": {
      "format": "double",
      "type": "number"
    },
    "current_value": {
      "format": "double",
      "type": "number"
    },
    "drain_rate_per_second": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "estimated_clear_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/ForecastId"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "resource": {
      "$ref": "#/$defs/ResourceRef"
    },
    "status": {
      "$ref": "#/$defs/ForecastStatus"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "cluster_id",
    "resource",
    "backlog_kind",
    "status",
    "current_value",
    "coverage_ratio",
    "algorithm_version",
    "evidence_ids",
    "observed_at"
  ],
  "title": "BacklogEta",
  "type": "object"
}
