{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "IncidentId": {
      "description": "Stable identifier for an SRE incident.",
      "format": "uuid",
      "type": "string"
    },
    "NotificationDeliveryId": {
      "description": "Stable identifier for one notification delivery.",
      "format": "uuid",
      "type": "string"
    },
    "NotificationDeliveryStatus": {
      "description": "Durable delivery state for the transactional outbox.",
      "enum": [
        "pending",
        "delivering",
        "delivered",
        "retry_scheduled",
        "failed"
      ],
      "type": "string"
    },
    "NotificationTargetId": {
      "description": "Stable identifier for a notification target.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One bounded, idempotent notification delivery.",
  "properties": {
    "attempt_count": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "deep_link": {
      "type": "string"
    },
    "delivered_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_key": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/NotificationDeliveryId"
    },
    "incident_id": {
      "$ref": "#/$defs/IncidentId"
    },
    "last_error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_attempt_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "sanitized_summary": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/NotificationDeliveryStatus"
    },
    "target_id": {
      "$ref": "#/$defs/NotificationTargetId"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "id",
    "target_id",
    "tenant_id",
    "cluster_id",
    "incident_id",
    "delivery_key",
    "status",
    "sanitized_summary",
    "deep_link",
    "attempt_count",
    "created_at"
  ],
  "title": "NotificationDelivery",
  "type": "object"
}
