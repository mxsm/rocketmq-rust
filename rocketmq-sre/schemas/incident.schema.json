{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "DiagnosticEvidence": {
      "description": "Evidence linked to a hypothesis with an explicit rationale.",
      "properties": {
        "confidence_percent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "rationale": {
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/EvidenceRelation"
        }
      },
      "required": [
        "evidence_id",
        "relation",
        "rationale",
        "confidence_percent"
      ],
      "type": "object"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceRelation": {
      "description": "Whether a piece of evidence supports or contradicts a hypothesis.",
      "enum": [
        "supports",
        "contradicts"
      ],
      "type": "string"
    },
    "Hypothesis": {
      "description": "Explainable diagnostic hypothesis with supporting and counter-evidence.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/DiagnosticEvidence"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "missing_evidence": {
          "description": "Evidence that must still be collected before this hypothesis can be\npromoted from an inconclusive state.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus"
        }
      },
      "required": [
        "id",
        "statement",
        "status"
      ],
      "type": "object"
    },
    "HypothesisStatus": {
      "description": "Evaluation state for a diagnostic hypothesis.",
      "enum": [
        "proposed",
        "supported",
        "rejected",
        "inconclusive"
      ],
      "type": "string"
    },
    "IncidentId": {
      "description": "Stable identifier for an SRE incident.",
      "format": "uuid",
      "type": "string"
    },
    "IncidentStatus": {
      "description": "Phase 00 incident lifecycle.",
      "enum": [
        "new",
        "collecting",
        "diagnosing",
        "needs_evidence",
        "monitoring",
        "resolved",
        "escalated"
      ],
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Versioned incident aggregate used by the diagnosis workflow.",
  "properties": {
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/IncidentId"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "cluster_id",
    "title",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "Incident",
  "type": "object"
}
