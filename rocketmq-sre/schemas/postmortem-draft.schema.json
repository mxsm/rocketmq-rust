{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "IncidentId": {
      "description": "Stable identifier for an SRE incident.",
      "format": "uuid",
      "type": "string"
    },
    "KnowledgeItemId": {
      "description": "Stable identifier for a knowledge item.",
      "format": "uuid",
      "type": "string"
    },
    "PostmortemId": {
      "description": "Stable identifier for a postmortem.",
      "format": "uuid",
      "type": "string"
    },
    "PostmortemStatus": {
      "description": "Postmortem lifecycle. Publication always requires an explicit human actor.",
      "enum": [
        "draft",
        "in_review",
        "confirmed",
        "published",
        "archived"
      ],
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Mutable postmortem head pointing at immutable revisions.",
  "properties": {
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "confirmed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "current_revision": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/PostmortemId"
    },
    "incident_id": {
      "$ref": "#/$defs/IncidentId"
    },
    "published_knowledge_item_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeItemId"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/PostmortemStatus"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "cluster_id",
    "incident_id",
    "status",
    "current_revision",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "title": "PostmortemDraft",
  "type": "object"
}
