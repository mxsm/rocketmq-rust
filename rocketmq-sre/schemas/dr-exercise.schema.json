{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "DrExecutionBoundary": {
      "description": "Runtime boundary enforced for an exercise.",
      "enum": [
        "read_only",
        "test_cluster_supervised"
      ],
      "type": "string"
    },
    "DrExerciseId": {
      "description": "Stable identifier for a disaster-recovery exercise.",
      "format": "uuid",
      "type": "string"
    },
    "DrExerciseMode": {
      "description": "Deliberately bounded exercise mode. Production cutover is not representable.",
      "enum": [
        "readiness",
        "tabletop",
        "supervised_test"
      ],
      "type": "string"
    },
    "DrExerciseState": {
      "description": "Exercise lifecycle.",
      "enum": [
        "planned",
        "running",
        "awaiting_manual_confirmation",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "DrPlanId": {
      "description": "Stable identifier for a versioned disaster-recovery plan.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "RegionId": {
      "description": "Stable identifier for a data-residency region.",
      "format": "uuid",
      "type": "string"
    },
    "RtoRpoTarget": {
      "description": "Recovery-point and recovery-time objectives.",
      "properties": {
        "rpo_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rto_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rto_seconds",
        "rpo_seconds"
      ],
      "type": "object"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Durable exercise head.",
  "properties": {
    "actual_rpo_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "actual_rto_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "boundary": {
      "$ref": "#/$defs/DrExecutionBoundary"
    },
    "cleanup_complete": {
      "type": "boolean"
    },
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/DrExerciseId"
    },
    "manual_checkpoint_count": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/DrExerciseMode"
    },
    "plan_id": {
      "$ref": "#/$defs/DrPlanId"
    },
    "region_id": {
      "$ref": "#/$defs/RegionId"
    },
    "started_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "$ref": "#/$defs/DrExerciseState"
    },
    "target": {
      "$ref": "#/$defs/RtoRpoTarget"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "plan_id",
    "tenant_id",
    "region_id",
    "mode",
    "boundary",
    "state",
    "target",
    "manual_checkpoint_count",
    "cleanup_complete",
    "evidence_ids",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "title": "DrExercise",
  "type": "object"
}
