{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "ReadinessFinding": {
      "description": "Explainable finding shared by upgrade and disaster-recovery reports.",
      "properties": {
        "code": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/EvidenceId"
          },
          "type": "array"
        },
        "remediation_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/ReadinessFindingSeverity"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "component",
        "summary",
        "evidence_ids"
      ],
      "type": "object"
    },
    "ReadinessFindingSeverity": {
      "description": "Severity of one deterministic readiness finding.",
      "enum": [
        "info",
        "warning",
        "blocker"
      ],
      "type": "string"
    },
    "ReadinessReportId": {
      "description": "Stable identifier for an immutable readiness report.",
      "format": "uuid",
      "type": "string"
    },
    "ReadinessStatus": {
      "description": "Aggregate readiness result.",
      "enum": [
        "ready",
        "ready_with_warnings",
        "blocked",
        "insufficient_data"
      ],
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Immutable upgrade-readiness assessment.",
  "properties": {
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "execution_eligible": {
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReadinessFinding"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/ReadinessReportId"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "pack_versions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ReadinessStatus"
    },
    "target_version": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "cluster_id",
    "target_version",
    "status",
    "findings",
    "pack_versions",
    "execution_eligible",
    "observed_at",
    "expires_at"
  ],
  "title": "UpgradeReadinessReport",
  "type": "object"
}
