{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "ExecutionId": {
      "description": "Stable identifier for a supervised execution.",
      "format": "uuid",
      "type": "string"
    },
    "ExecutionStepId": {
      "description": "Stable identifier for an execution step.",
      "format": "uuid",
      "type": "string"
    },
    "LeaseEpoch": {
      "description": "Monotonically increasing cluster fencing epoch.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "LeaseId": {
      "description": "Stable identifier for an executor lease generation.",
      "format": "uuid",
      "type": "string"
    },
    "PlanStepId": {
      "description": "Stable identifier for an immutable action plan step.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request for a fresh, step-scoped dispatch grant.",
  "properties": {
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "epoch": {
      "$ref": "#/$defs/LeaseEpoch"
    },
    "execution_id": {
      "$ref": "#/$defs/ExecutionId"
    },
    "lease_id": {
      "$ref": "#/$defs/LeaseId"
    },
    "plan_step_id": {
      "$ref": "#/$defs/PlanStepId"
    },
    "schema_version": {
      "type": "string"
    },
    "step_id": {
      "$ref": "#/$defs/ExecutionStepId"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "cluster_id",
    "lease_id",
    "epoch",
    "execution_id",
    "step_id",
    "plan_step_id"
  ],
  "title": "IssueFenceGrantRequest",
  "type": "object"
}
