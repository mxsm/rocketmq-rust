{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "IntegrationAdapterKind": {
      "description": "Closed adapter families supported by the first integration SPI.",
      "enum": [
        "mock_itsm",
        "signed_webhook_itsm",
        "chat_ops_webhook",
        "pager",
        "email"
      ],
      "type": "string"
    },
    "IntegrationEventKind": {
      "description": "Events an external adapter may receive.",
      "enum": [
        "plan_submitted",
        "approval_changed",
        "release_started",
        "release_paused",
        "release_rolling_back",
        "release_completed",
        "manual_takeover_required"
      ],
      "type": "string"
    },
    "IntegrationTargetId": {
      "description": "Stable identifier for one tenant-scoped external integration target.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Tenant- and cluster-scoped adapter configuration.\n\nCredentials are represented only by a secret reference and are never part\nof a delivery, model input, audit detail, or operator-facing view.",
  "properties": {
    "adapter_kind": {
      "$ref": "#/$defs/IntegrationAdapterKind"
    },
    "cluster_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClusterId"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "descriptor_id": {
      "type": "string"
    },
    "descriptor_version": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/IntegrationTargetId"
    },
    "inbound_approval": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "outbound_events": {
      "items": {
        "$ref": "#/$defs/IntegrationEventKind"
      },
      "type": "array",
      "uniqueItems": true
    },
    "secret_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "descriptor_id",
    "descriptor_version",
    "name",
    "adapter_kind",
    "endpoint",
    "enabled",
    "inbound_approval",
    "outbound_events",
    "created_at",
    "updated_at"
  ],
  "title": "IntegrationTarget",
  "type": "object"
}
