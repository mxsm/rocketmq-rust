{
  "$defs": {
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "ExecutorLease": {
      "additionalProperties": false,
      "description": "Durable lease projection returned by the PostgreSQL Lease Authority.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "type": "string"
        },
        "activated_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "epoch": {
          "$ref": "#/$defs/LeaseEpoch"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/LeaseId"
        },
        "owner": {
          "type": "string"
        },
        "pending_nonce": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/LeaseState"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "cluster_id",
        "epoch",
        "owner",
        "state",
        "pending_nonce",
        "acquired_at",
        "expires_at"
      ],
      "type": "object"
    },
    "LeaseEpoch": {
      "description": "Monotonically increasing cluster fencing epoch.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "LeaseId": {
      "description": "Stable identifier for an executor lease generation.",
      "format": "uuid",
      "type": "string"
    },
    "LeaseState": {
      "description": "Two-phase executor lease state.",
      "enum": [
        "pending_fence",
        "active",
        "expired"
      ],
      "type": "string"
    },
    "ReconcileGrant": {
      "additionalProperties": false,
      "description": "Read-only grant used while a pending owner reconciles old effects.",
      "properties": {
        "audience": {
          "type": "string"
        },
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "lease_id": {
          "$ref": "#/$defs/LeaseId"
        },
        "nonce": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "pending_epoch": {
          "$ref": "#/$defs/LeaseEpoch"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": [
        "lease_id",
        "owner",
        "cluster_id",
        "pending_epoch",
        "audience",
        "issued_at",
        "expires_at",
        "nonce",
        "signature"
      ],
      "type": "object"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Pending lease and read-only reconciliation capability.",
  "properties": {
    "lease": {
      "$ref": "#/$defs/ExecutorLease"
    },
    "reconcile_grant": {
      "$ref": "#/$defs/ReconcileGrant"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "lease",
    "reconcile_grant"
  ],
  "title": "BeginLeaseTakeoverResponse",
  "type": "object"
}
