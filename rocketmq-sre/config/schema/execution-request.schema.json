{
  "$defs": {
    "ActionPlan": {
      "additionalProperties": false,
      "description": "Immutable supervised action plan bound to one model-backed diagnosis.",
      "properties": {
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "diagnosis_execution_eligible": {
          "type": "boolean"
        },
        "diagnosis_revision": {
          "$ref": "#/$defs/DiagnosisRevisionId"
        },
        "evidence_hash": {
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ActionPlanId"
        },
        "incident_id": {
          "$ref": "#/$defs/IncidentId"
        },
        "plan_hash": {
          "type": "string"
        },
        "primary_model_invocation_id": {
          "$ref": "#/$defs/ModelInvocationId"
        },
        "schema_version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PlanStatus"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "type": "array"
        },
        "submitted_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "id",
        "tenant_id",
        "cluster_id",
        "incident_id",
        "diagnosis_revision",
        "primary_model_invocation_id",
        "diagnosis_execution_eligible",
        "version",
        "created_by",
        "created_at",
        "expires_at",
        "evidence_hash",
        "steps",
        "status",
        "plan_hash"
      ],
      "type": "object"
    },
    "ActionPlanId": {
      "description": "Stable identifier for an immutable action plan.",
      "format": "uuid",
      "type": "string"
    },
    "ApprovalGrant": {
      "additionalProperties": false,
      "description": "Short-lived Control Plane grant accepted only by the Executor audience.",
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/ApprovalId"
        },
        "approver_subject": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "cluster_id": {
          "$ref": "#/$defs/ClusterId"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "plan_hash": {
          "type": "string"
        },
        "plan_id": {
          "$ref": "#/$defs/ActionPlanId"
        },
        "precondition_hash": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        }
      },
      "required": [
        "issuer",
        "audience",
        "approval_id",
        "plan_id",
        "plan_hash",
        "precondition_hash",
        "tenant_id",
        "cluster_id",
        "approver_subject",
        "issued_at",
        "expires_at",
        "nonce",
        "signature"
      ],
      "type": "object"
    },
    "ApprovalId": {
      "description": "Stable identifier for an approval decision.",
      "format": "uuid",
      "type": "string"
    },
    "ClusterId": {
      "description": "Internal identifier for an onboarded cluster.",
      "format": "uuid",
      "type": "string"
    },
    "CompensationMode": {
      "description": "Deterministic compensation mode.",
      "enum": [
        "automatic",
        "manual_takeover",
        "not_available"
      ],
      "type": "string"
    },
    "CompensationSpec": {
      "additionalProperties": false,
      "description": "Compensation behavior frozen by an action descriptor.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CompensationMode"
        },
        "required_before_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "CorrelationId": {
      "description": "Identifier propagated across one logical SRE operation.",
      "format": "uuid",
      "type": "string"
    },
    "DiagnosisRevisionId": {
      "description": "Stable identifier for an immutable diagnosis revision.",
      "format": "uuid",
      "type": "string"
    },
    "EvidenceId": {
      "description": "Stable identifier for an evidence snapshot.",
      "format": "uuid",
      "type": "string"
    },
    "ExecutionAction": {
      "description": "Closed set of Phase 3 actions that may enter supervised execution.\n\nR3 and unknown actions are intentionally not representable.",
      "enum": [
        "observability.logger_level_ttl.v1",
        "proxy.scale_out_one.v1",
        "proxy.restart_one.v1",
        "broker.config.patch_allowlisted.v1",
        "topic.config.patch_allowlisted.v1"
      ],
      "type": "string"
    },
    "ExecutionId": {
      "description": "Stable identifier for a supervised execution.",
      "format": "uuid",
      "type": "string"
    },
    "ImpactScope": {
      "description": "Maximum descriptor-authorized blast radius.",
      "enum": [
        "single_resource",
        "single_instance",
        "one_replica",
        "allowlisted_fields"
      ],
      "type": "string"
    },
    "IncidentId": {
      "description": "Stable identifier for an SRE incident.",
      "format": "uuid",
      "type": "string"
    },
    "ModelInvocationId": {
      "description": "Stable identifier for a model invocation.",
      "format": "uuid",
      "type": "string"
    },
    "PlanStatus": {
      "description": "Immutable action-plan lifecycle.",
      "enum": [
        "draft",
        "needs_critic",
        "ready_for_approval",
        "in_review",
        "approved",
        "rejected",
        "expired",
        "superseded"
      ],
      "type": "string"
    },
    "PlanStep": {
      "additionalProperties": false,
      "description": "One typed and bounded step in an immutable plan.",
      "properties": {
        "action": {
          "$ref": "#/$defs/ExecutionAction"
        },
        "compensation": {
          "$ref": "#/$defs/CompensationSpec"
        },
        "descriptor_version": {
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceId"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/PlanStepId"
        },
        "max_impact": {
          "$ref": "#/$defs/ImpactScope"
        },
        "parameters": true,
        "precondition_hash": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "sequence": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "verification": {
          "$ref": "#/$defs/VerificationSpec"
        }
      },
      "required": [
        "id",
        "sequence",
        "action",
        "descriptor_version",
        "resource",
        "parameters",
        "precondition_hash",
        "max_impact",
        "verification",
        "compensation"
      ],
      "type": "object"
    },
    "PlanStepId": {
      "description": "Stable identifier for an immutable action plan step.",
      "format": "uuid",
      "type": "string"
    },
    "TenantId": {
      "description": "Stable tenant boundary identifier.",
      "format": "uuid",
      "type": "string"
    },
    "VerificationSpec": {
      "additionalProperties": false,
      "description": "Verification policy frozen by an action descriptor.",
      "properties": {
        "max_wait_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resource_conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stable_window_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "technical_slis": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "stable_window_seconds",
        "max_wait_seconds"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Short-lived immutable request submitted to Change Executor.",
  "properties": {
    "approvals": {
      "items": {
        "$ref": "#/$defs/ApprovalGrant"
      },
      "type": "array"
    },
    "audience": {
      "type": "string"
    },
    "cluster_id": {
      "$ref": "#/$defs/ClusterId"
    },
    "correlation_id": {
      "$ref": "#/$defs/CorrelationId"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/ExecutionId"
    },
    "idempotency_key": {
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ActionPlan"
    },
    "requested_by": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/TenantId"
    }
  },
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "cluster_id",
    "correlation_id",
    "plan",
    "approvals",
    "requested_by",
    "idempotency_key",
    "issuer",
    "audience",
    "issued_at",
    "expires_at",
    "nonce",
    "signature"
  ],
  "title": "ExecutionRequest",
  "type": "object"
}
